# expr.nox — Declarative filter expressions and row predicates for Atlas.

import nox.strings
import nox.regex
import errors
from errors import ColumnNotFoundError
import values
from values import Cell, cell_null, cell_int, cell_float, cell_str, cell_bool, cell_decimal_str, cell_datetime_str
import schema
from schema import Schema

OP_EQ: int = 1
OP_NEQ: int = 2
OP_GT: int = 3
OP_GTE: int = 4
OP_LT: int = 5
OP_LTE: int = 6
OP_IS_MISSING: int = 7
OP_NOT_MISSING: int = 8
OP_CONTAINS: int = 9
OP_STARTS_WITH: int = 10
OP_IN: int = 11
OP_AND: int = 12
OP_OR: int = 13
OP_NOT: int = 14
OP_ENDS_WITH: int = 15
OP_REGEX_MATCH: int = 16
OP_EQ_CI: int = 17

enum ExprOp:
    Eq
    Neq
    Gt
    Gte
    Lt
    Lte
    IsMissing
    NotMissing
    Contains
    StartsWith
    In
    And
    Or
    Not
    EndsWith
    RegexMatch
    EqCi

def expr_op_from_int(op: int) -> ExprOp:
    if op == OP_NEQ:
        return ExprOp.Neq
    if op == OP_GT:
        return ExprOp.Gt
    if op == OP_GTE:
        return ExprOp.Gte
    if op == OP_LT:
        return ExprOp.Lt
    if op == OP_LTE:
        return ExprOp.Lte
    if op == OP_IS_MISSING:
        return ExprOp.IsMissing
    if op == OP_NOT_MISSING:
        return ExprOp.NotMissing
    if op == OP_CONTAINS:
        return ExprOp.Contains
    if op == OP_STARTS_WITH:
        return ExprOp.StartsWith
    if op == OP_IN:
        return ExprOp.In
    if op == OP_AND:
        return ExprOp.And
    if op == OP_OR:
        return ExprOp.Or
    if op == OP_NOT:
        return ExprOp.Not
    if op == OP_ENDS_WITH:
        return ExprOp.EndsWith
    if op == OP_REGEX_MATCH:
        return ExprOp.RegexMatch
    if op == OP_EQ_CI:
        return ExprOp.EqCi
    return ExprOp.Eq

def expr_op_to_int(eo: ExprOp) -> int:
    code: int = OP_EQ
    match eo:
        case ExprOp.Eq:
            code = OP_EQ
        case ExprOp.Neq:
            code = OP_NEQ
        case ExprOp.Gt:
            code = OP_GT
        case ExprOp.Gte:
            code = OP_GTE
        case ExprOp.Lt:
            code = OP_LT
        case ExprOp.Lte:
            code = OP_LTE
        case ExprOp.IsMissing:
            code = OP_IS_MISSING
        case ExprOp.NotMissing:
            code = OP_NOT_MISSING
        case ExprOp.Contains:
            code = OP_CONTAINS
        case ExprOp.StartsWith:
            code = OP_STARTS_WITH
        case ExprOp.In:
            code = OP_IN
        case ExprOp.And:
            code = OP_AND
        case ExprOp.Or:
            code = OP_OR
        case ExprOp.Not:
            code = OP_NOT
        case ExprOp.EndsWith:
            code = OP_ENDS_WITH
        case ExprOp.RegexMatch:
            code = OP_REGEX_MATCH
        case ExprOp.EqCi:
            code = OP_EQ_CI
    return code

def expr_op_name(eo: ExprOp) -> str:
    name: str = "EQ"
    match eo:
        case ExprOp.Eq:
            name = "EQ"
        case ExprOp.Neq:
            name = "NEQ"
        case ExprOp.Gt:
            name = "GT"
        case ExprOp.Gte:
            name = "GTE"
        case ExprOp.Lt:
            name = "LT"
        case ExprOp.Lte:
            name = "LTE"
        case ExprOp.IsMissing:
            name = "IS_MISSING"
        case ExprOp.NotMissing:
            name = "NOT_MISSING"
        case ExprOp.Contains:
            name = "CONTAINS"
        case ExprOp.StartsWith:
            name = "STARTS_WITH"
        case ExprOp.In:
            name = "IN"
        case ExprOp.And:
            name = "AND"
        case ExprOp.Or:
            name = "OR"
        case ExprOp.Not:
            name = "NOT"
        case ExprOp.EndsWith:
            name = "ENDS_WITH"
        case ExprOp.RegexMatch:
            name = "REGEX_MATCH"
        case ExprOp.EqCi:
            name = "EQ_CI"
    return name

class Expr:
    op: int
    col_name: str
    val: Cell
    val_list: list[Cell]
    str_arg: str
    left: Expr | None
    right: Expr | None

    def __init__(self: Expr, op: int, col_name: str, val: Cell, val_list: list[Cell], str_arg: str, left: Expr | None, right: Expr | None) -> None:
        self.op = op
        self.col_name = col_name
        self.val = val
        self.val_list = val_list
        self.str_arg = str_arg
        self.left = left
        self.right = right

    def expr_op(self: Expr) -> ExprOp:
        return expr_op_from_int(self.op)

    def op_name(self: Expr) -> str:
        return expr_op_name(self.expr_op())

    def evaluate(self: Expr, s: Schema, row: list[Cell]) -> bool:

        if self.op == OP_AND:
            l: Expr | None = self.left
            r: Expr | None = self.right
            if l != None and r != None:
                return l.evaluate(s, row) and r.evaluate(s, row)
            return False

        if self.op == OP_OR:
            l: Expr | None = self.left
            r: Expr | None = self.right
            if l != None and r != None:
                return l.evaluate(s, row) or r.evaluate(s, row)
            return False

        if self.op == OP_NOT:
            l: Expr | None = self.left
            if l != None:
                return not l.evaluate(s, row)
            return False

        col_idx: int = s.index_of(self.col_name)
        if col_idx < 0:
            raise ColumnNotFoundError("filter expression refers to unknown column: '" + self.col_name + "'")

        cell: Cell = row[col_idx]

        if self.op == OP_IS_MISSING:
            return cell.is_missing()

        if self.op == OP_NOT_MISSING:
            return not cell.is_missing()

        # For comparison operators, missing cells evaluate to False
        if cell.is_missing():
            return False

        if self.op == OP_EQ:
            return cell.equals(self.val)

        if self.op == OP_NEQ:
            return not cell.equals(self.val)

        if self.op == OP_GT:
            return cell.compare(self.val) > 0

        if self.op == OP_GTE:
            return cell.compare(self.val) >= 0

        if self.op == OP_LT:
            return cell.compare(self.val) < 0

        if self.op == OP_LTE:
            return cell.compare(self.val) <= 0

        if self.op == OP_CONTAINS:
            return nox.strings.contains(cell.to_string(), self.str_arg)

        if self.op == OP_STARTS_WITH:
            return nox.strings.starts_with(cell.to_string(), self.str_arg)

        if self.op == OP_ENDS_WITH:
            return nox.strings.ends_with(cell.to_string(), self.str_arg)

        if self.op == OP_REGEX_MATCH:
            return nox.regex.search(self.str_arg, cell.to_string()) != None

        if self.op == OP_EQ_CI:
            return nox.strings.eq_ignore_case(cell.to_string(), self.str_arg)

        if self.op == OP_IN:
            i: int = 0
            n: int = len(self.val_list)
            while i < n:
                if cell.equals(self.val_list[i]):
                    return True
                i = i + 1
            return False

        return False

def _empty_cells() -> list[Cell]:
    empty: list[Cell] = []
    return empty

def col_eq(col: str, val: Cell) -> Expr:
    return Expr(OP_EQ, col, val, _empty_cells(), "", None, None)

def col_eq_int(col: str, i: int) -> Expr:
    return col_eq(col, cell_int(i))

def col_eq_str(col: str, s: str) -> Expr:
    return col_eq(col, cell_str(s))

def col_eq_bool(col: str, b: bool) -> Expr:
    return col_eq(col, cell_bool(b))

def col_neq(col: str, val: Cell) -> Expr:
    return Expr(OP_NEQ, col, val, _empty_cells(), "", None, None)

def col_neq_int(col: str, i: int) -> Expr:
    return col_neq(col, cell_int(i))

def col_neq_str(col: str, s: str) -> Expr:
    return col_neq(col, cell_str(s))

def col_gt(col: str, val: Cell) -> Expr:
    return Expr(OP_GT, col, val, _empty_cells(), "", None, None)

def col_gt_int(col: str, i: int) -> Expr:
    return col_gt(col, cell_int(i))

def col_gt_float(col: str, f: float) -> Expr:
    return col_gt(col, cell_float(f))

def col_gte(col: str, val: Cell) -> Expr:
    return Expr(OP_GTE, col, val, _empty_cells(), "", None, None)

def col_gte_int(col: str, i: int) -> Expr:
    return col_gte(col, cell_int(i))

def col_gte_float(col: str, f: float) -> Expr:
    return col_gte(col, cell_float(f))

def col_lt(col: str, val: Cell) -> Expr:
    return Expr(OP_LT, col, val, _empty_cells(), "", None, None)

def col_lt_int(col: str, i: int) -> Expr:
    return col_lt(col, cell_int(i))

def col_lt_float(col: str, f: float) -> Expr:
    return col_lt(col, cell_float(f))

def col_lte(col: str, val: Cell) -> Expr:
    return Expr(OP_LTE, col, val, _empty_cells(), "", None, None)

def col_lte_int(col: str, i: int) -> Expr:
    return col_lte(col, cell_int(i))

def col_lte_float(col: str, f: float) -> Expr:
    return col_lte(col, cell_float(f))

def col_is_missing(col: str) -> Expr:
    return Expr(OP_IS_MISSING, col, cell_null(), _empty_cells(), "", None, None)

def col_not_missing(col: str) -> Expr:
    return Expr(OP_NOT_MISSING, col, cell_null(), _empty_cells(), "", None, None)

def col_contains(col: str, sub: str) -> Expr:
    return Expr(OP_CONTAINS, col, cell_null(), _empty_cells(), sub, None, None)

def col_starts_with(col: str, prefix: str) -> Expr:
    return Expr(OP_STARTS_WITH, col, cell_null(), _empty_cells(), prefix, None, None)

def col_ends_with(col: str, suffix: str) -> Expr:
    return Expr(OP_ENDS_WITH, col, cell_null(), _empty_cells(), suffix, None, None)

def col_regex_match(col: str, pattern: str) -> Expr:
    # Validate regex syntax eagerly on expression construction
    _chk: nox.regex.Match | None = nox.regex.search(pattern, "")
    return Expr(OP_REGEX_MATCH, col, cell_null(), _empty_cells(), pattern, None, None)

def col_eq_ignore_case(col: str, target: str) -> Expr:
    return Expr(OP_EQ_CI, col, cell_null(), _empty_cells(), target, None, None)

def col_in(col: str, values_list: list[Cell]) -> Expr:
    return Expr(OP_IN, col, cell_null(), values_list, "", None, None)

def expr_and(left: Expr, right: Expr) -> Expr:
    return Expr(OP_AND, "", cell_null(), _empty_cells(), "", left, right)

def expr_or(left: Expr, right: Expr) -> Expr:
    return Expr(OP_OR, "", cell_null(), _empty_cells(), "", left, right)

def expr_not(inner: Expr) -> Expr:
    return Expr(OP_NOT, "", cell_null(), _empty_cells(), "", inner, None)

def col_eq_decimal(col: str, val_str: str) -> Expr:
    return col_eq(col, cell_decimal_str(val_str))

def col_gt_decimal(col: str, val_str: str) -> Expr:
    return col_gt(col, cell_decimal_str(val_str))

def col_gte_decimal(col: str, val_str: str) -> Expr:
    return col_gte(col, cell_decimal_str(val_str))

def col_lt_decimal(col: str, val_str: str) -> Expr:
    return col_lt(col, cell_decimal_str(val_str))

def col_lte_decimal(col: str, val_str: str) -> Expr:
    return col_lte(col, cell_decimal_str(val_str))

def col_eq_datetime(col: str, iso_str: str) -> Expr:
    return col_eq(col, cell_datetime_str(iso_str))

def col_gt_datetime(col: str, iso_str: str) -> Expr:
    return col_gt(col, cell_datetime_str(iso_str))

def col_gte_datetime(col: str, iso_str: str) -> Expr:
    return col_gte(col, cell_datetime_str(iso_str))

def col_lt_datetime(col: str, iso_str: str) -> Expr:
    return col_lt(col, cell_datetime_str(iso_str))

def col_lte_datetime(col: str, iso_str: str) -> Expr:
    return col_lte(col, cell_datetime_str(iso_str))

def col_between_datetime(col: str, start_iso: str, end_iso: str) -> Expr:
    return expr_and(col_gte_datetime(col, start_iso), col_lte_datetime(col, end_iso))
