# sort.nox — Multi-column stable merge sort for table rows.

import errors
from errors import SortError
import values
from values import Cell
import schema
from schema import Schema

def compare_rows(row_a: list[Cell], row_b: list[Cell], col_indices: list[int], ascending_flags: list[bool], nulls_first: bool) -> int:
    k: int = 0
    num_keys: int = len(col_indices)
    while k < num_keys:
        idx: int = col_indices[k]
        asc: bool = ascending_flags[k]
        cmp: int = row_a[idx].compare(row_b[idx], nulls_first)
        if cmp != 0:
            if not asc:
                return -cmp
            return cmp
        k = k + 1
    return 0

def sort_rows(s: Schema, rows: list[list[Cell]], col_indices: list[int], ascending_flags: list[bool], nulls_first: bool) -> list[list[Cell]]:
    n: int = len(rows)
    if n <= 1:
        # Return a shallow copy of rows
        res_single: list[list[Cell]] = []
        i_single: int = 0
        while i_single < n:
            res_single.append(rows[i_single])
            i_single = i_single + 1
        return res_single

    if len(col_indices) != len(ascending_flags):
        raise SortError("sort column indices and ascending flags must have identical length")

    mid: int = n // 2
    left: list[list[Cell]] = []
    i: int = 0
    while i < mid:
        left.append(rows[i])
        i = i + 1

    right: list[list[Cell]] = []
    while i < n:
        right.append(rows[i])
        i = i + 1

    sorted_left: list[list[Cell]] = sort_rows(s, left, col_indices, ascending_flags, nulls_first)
    sorted_right: list[list[Cell]] = sort_rows(s, right, col_indices, ascending_flags, nulls_first)

    merged: list[list[Cell]] = []
    l_idx: int = 0
    r_idx: int = 0
    nl: int = len(sorted_left)
    nr: int = len(sorted_right)

    while l_idx < nl and r_idx < nr:
        # cmp <= 0 preserves stability by taking left element first on tie
        cmp_val: int = compare_rows(sorted_left[l_idx], sorted_right[r_idx], col_indices, ascending_flags, nulls_first)
        if cmp_val <= 0:
            merged.append(sorted_left[l_idx])
            l_idx = l_idx + 1
        else:
            merged.append(sorted_right[r_idx])
            r_idx = r_idx + 1

    while l_idx < nl:
        merged.append(sorted_left[l_idx])
        l_idx = l_idx + 1

    while r_idx < nr:
        merged.append(sorted_right[r_idx])
        r_idx = r_idx + 1

    return merged
