# Convenience functional statistics API matching AGENTS.md:
def col_mean(t: Table, col_name: str) -> float:
    return t.mean(col_name)

def col_median(t: Table, col_name: str) -> float:
    return t.median(col_name)

def col_std(t: Table, col_name: str, is_sample: bool = True) -> float:
    return t.std(col_name, is_sample)

def col_variance(t: Table, col_name: str, is_sample: bool = True) -> float:
    return t.variance(col_name, is_sample)

def col_min(t: Table, col_name: str) -> Cell:
    return t.min_val(col_name)

def col_max(t: Table, col_name: str) -> Cell:
    return t.max_val(col_name)

def col_sum(t: Table, col_name: str) -> float:
    return t.sum_val(col_name)

def col_count(t: Table, col_name: str) -> int:
    return t.count_val(col_name)

def col_count_missing(t: Table, col_name: str) -> int:
    return t.count_missing(col_name)
