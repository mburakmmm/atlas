# parallel_exec.nox — Shared-nothing parallel execution helpers for Atlas using Nox structured concurrency.
# Builds disjoint, per-worker cloned packets before spawning tasks so concurrent workers share
# zero ARC-managed heap objects across OS threads (deterministic across both QBE and LLVM).

__all__: list[str] = [
    "clone_isolated_str", "clone_isolated_cell", "clone_isolated_row",
    "clone_isolated_schema", "clone_isolated_expr", "sort_partition_indices",
    "parallel_filter_rows", "compute_agg_cell", "compute_agg_slice",
    "parallel_compute_agg_rows", "parallel_sort_partitions", "async_filter_rows"
]

import nox.thread
import nox.decimal
from nox.decimal import Decimal
import errors
from errors import AggregationError
import values
from values import Cell, cell_int, cell_float, cell_null, cell_decimal, TYPE_INT, TYPE_DECIMAL
import schema
from schema import Schema, ColumnDef
import stats
from stats import stat_mean, stat_median, stat_variance, stat_std, stat_sum, stat_sum_int, stat_sum_decimal, stat_mean_decimal, stat_min, stat_max, stat_count_non_missing
import sort
from sort import compare_rows
import expr
from expr import Expr

DEFAULT_WORKERS: int = 4

# Local constants matching groupby.AGG_* to avoid import cycles
_AGG_COUNT: int = 1
_AGG_SUM: int = 2
_AGG_MEAN: int = 3
_AGG_MEDIAN: int = 4
_AGG_STD: int = 5
_AGG_VARIANCE: int = 6
_AGG_MIN: int = 7
_AGG_MAX: int = 8
_AGG_COUNT_NON_MISSING: int = 9

# ---------------------------------------------------------------------------
# Shared-nothing deep-cloning utilities for thread-safe worker isolation
# ---------------------------------------------------------------------------

def clone_isolated_str(s: str) -> str:
    if len(s) == 0:
        return ""
    prefixed: str = "x" + s
    return prefixed[1:]

def clone_isolated_cell(c: Cell) -> Cell:
    d_copy: Decimal | None = None
    d_orig: Decimal | None = c.d
    if d_orig != None:
        d_copy = d_orig + nox.decimal.from_int(0)
    return Cell(c.kind, c.i, c.f, clone_isolated_str(c.s), c.b, d_copy)

def clone_isolated_row(row: list[Cell]) -> list[Cell]:
    out: list[Cell] = []
    i: int = 0
    n: int = len(row)
    while i < n:
        out.append(clone_isolated_cell(row[i]))
        i = i + 1
    return out

def clone_isolated_schema(s: Schema) -> Schema:
    cols: list[ColumnDef] = []
    i: int = 0
    n: int = len(s.columns)
    while i < n:
        c: ColumnDef = s.columns[i]
        cols.append(ColumnDef(clone_isolated_str(c.name), c.data_type, c.nullable))
        i = i + 1
    return Schema(cols)

def clone_isolated_expr(e: Expr) -> Expr:
    vals_copy: list[Cell] = []
    i: int = 0
    while i < len(e.val_list):
        vals_copy.append(clone_isolated_cell(e.val_list[i]))
        i = i + 1
    left_copy: Expr | None = None
    e_left: Expr | None = e.left
    if e_left != None:
        left_copy = clone_isolated_expr(e_left)
    right_copy: Expr | None = None
    e_right: Expr | None = e.right
    if e_right != None:
        right_copy = clone_isolated_expr(e_right)
    return Expr(
        e.op,
        clone_isolated_str(e.col_name),
        clone_isolated_cell(e.val),
        vals_copy,
        clone_isolated_str(e.str_arg),
        left_copy,
        right_copy
    )

def _clone_int_list(xs: list[int]) -> list[int]:
    out: list[int] = []
    i: int = 0
    while i < len(xs):
        out.append(xs[i])
        i = i + 1
    return out

def _clone_bool_list(xs: list[bool]) -> list[bool]:
    out: list[bool] = []
    i: int = 0
    while i < len(xs):
        out.append(xs[i])
        i = i + 1
    return out

# ---------------------------------------------------------------------------
# Shared partition merge-sort helper (used both sequentially and in parallel)
# ---------------------------------------------------------------------------

def sort_partition_indices(rows: list[list[Cell]], indices: list[int],
                           order_col_indices: list[int], ascending_flags: list[bool]) -> list[int]:
    n: int = len(indices)
    if n <= 1 or len(order_col_indices) == 0:
        res: list[int] = []
        i: int = 0
        while i < n:
            res.append(indices[i])
            i = i + 1
        return res

    mid: int = n // 2
    right_len: int = n - mid
    left_ind: list[int] = [0] * mid
    i: int = 0
    while i < mid:
        left_ind[i] = indices[i]
        i = i + 1

    right_ind: list[int] = [0] * right_len
    ri_off: int = 0
    while i < n:
        right_ind[ri_off] = indices[i]
        ri_off = ri_off + 1
        i = i + 1

    sorted_left: list[int] = sort_partition_indices(rows, left_ind, order_col_indices, ascending_flags)
    sorted_right: list[int] = sort_partition_indices(rows, right_ind, order_col_indices, ascending_flags)

    nl: int = len(sorted_left)
    nr: int = len(sorted_right)
    merged: list[int] = [0] * (nl + nr)
    l_idx: int = 0
    r_idx: int = 0
    m_idx: int = 0

    while l_idx < nl and r_idx < nr:
        row_l: list[Cell] = rows[sorted_left[l_idx]]
        row_r: list[Cell] = rows[sorted_right[r_idx]]
        cmp_val: int = compare_rows(row_l, row_r, order_col_indices, ascending_flags, False)
        if cmp_val <= 0:
            merged[m_idx] = sorted_left[l_idx]
            l_idx = l_idx + 1
        else:
            merged[m_idx] = sorted_right[r_idx]
            r_idx = r_idx + 1
        m_idx = m_idx + 1

    while l_idx < nl:
        merged[m_idx] = sorted_left[l_idx]
        l_idx = l_idx + 1
        m_idx = m_idx + 1

    while r_idx < nr:
        merged[m_idx] = sorted_right[r_idx]
        r_idx = r_idx + 1
        m_idx = m_idx + 1

    return merged

# ---------------------------------------------------------------------------
# 1. Parallel Filter (disjoint per-worker packets)
# ---------------------------------------------------------------------------

class _FilterSlicePacket:
    s: Schema
    rows: list[list[Cell]]
    predicate: Expr

    def __init__(self: _FilterSlicePacket, s: Schema, rows: list[list[Cell]], predicate: Expr) -> None:
        self.s = s
        self.rows = rows
        self.predicate = predicate

class _FilterTaskHandle:
    t: Task[list[list[Cell]]]

    def __init__(self: _FilterTaskHandle, t: Task[list[list[Cell]]]) -> None:
        self.t = t

_active_filter_packets: list[_FilterSlicePacket] = []
_active_filter_out: list[list[Cell]] = []

async def _filter_slice_worker(pkt: _FilterSlicePacket) -> list[list[Cell]]:
    matched: list[list[Cell]] = []
    i: int = 0
    n: int = len(pkt.rows)
    while i < n:
        r: list[Cell] = pkt.rows[i]
        if pkt.predicate.evaluate(pkt.s, r):
            matched.append(r)
        i = i + 1
    return matched

def _build_filter_packets(s: Schema, rows: list[list[Cell]], predicate: Expr, w_cnt: int) -> list[_FilterSlicePacket]:
    n: int = len(rows)
    packets: list[_FilterSlicePacket] = []
    chunk: int = (n + w_cnt - 1) // w_cnt
    w: int = 0
    while w < w_cnt:
        start_i: int = w * chunk
        if start_i < n:
            end_i: int = start_i + chunk
            if end_i > n:
                end_i = n
            slice_rows: list[list[Cell]] = []
            ri: int = start_i
            while ri < end_i:
                slice_rows.append(clone_isolated_row(rows[ri]))
                ri = ri + 1
            packets.append(_FilterSlicePacket(clone_isolated_schema(s), slice_rows, clone_isolated_expr(predicate)))
        w = w + 1
    return packets

async def async_filter_rows(s: Schema, rows: list[list[Cell]], predicate: Expr, workers: int = 4) -> list[list[Cell]]:
    n: int = len(rows)
    if n == 0:
        return []
    w_cnt: int = workers
    if w_cnt < 1:
        w_cnt = 1
    if w_cnt > n:
        w_cnt = n
    if w_cnt <= 1:
        matched: list[list[Cell]] = []
        i: int = 0
        while i < n:
            if predicate.evaluate(s, rows[i]):
                matched.append(rows[i])
            i = i + 1
        return matched

    packets: list[_FilterSlicePacket] = _build_filter_packets(s, rows, predicate, w_cnt)
    handles: list[_FilterTaskHandle] = []
    pi: int = 0
    while pi < len(packets):
        pkt: _FilterSlicePacket = packets[pi]
        handles.append(_FilterTaskHandle(spawn _filter_slice_worker(pkt)))
        pi = pi + 1

    out: list[list[Cell]] = []
    ti: int = 0
    while ti < len(handles):
        part: list[list[Cell]] = await handles[ti].t
        j: int = 0
        while j < len(part):
            out.append(part[j])
            j = j + 1
        ti = ti + 1
    return out

async def _filter_pool_entry() -> None:
    handles: list[_FilterTaskHandle] = []
    pi: int = 0
    while pi < len(_active_filter_packets):
        pkt: _FilterSlicePacket = _active_filter_packets[pi]
        handles.append(_FilterTaskHandle(spawn _filter_slice_worker(pkt)))
        pi = pi + 1

    out: list[list[Cell]] = []
    ti: int = 0
    while ti < len(handles):
        part: list[list[Cell]] = await handles[ti].t
        j: int = 0
        while j < len(part):
            out.append(part[j])
            j = j + 1
        ti = ti + 1
    _active_filter_out = out

def parallel_filter_rows(s: Schema, rows: list[list[Cell]], predicate: Expr, workers: int = 4) -> list[list[Cell]]:
    if len(rows) < 2:
        matched: list[list[Cell]] = []
        i: int = 0
        while i < len(rows):
            if predicate.evaluate(s, rows[i]):
                matched.append(rows[i])
            i = i + 1
        return matched

    w_cnt: int = workers
    if w_cnt < 1:
        w_cnt = 1
    if w_cnt > len(rows):
        w_cnt = len(rows)
    if w_cnt <= 1:
        matched1: list[list[Cell]] = []
        i1: int = 0
        while i1 < len(rows):
            if predicate.evaluate(s, rows[i1]):
                matched1.append(rows[i1])
            i1 = i1 + 1
        return matched1

    _active_filter_packets = _build_filter_packets(s, rows, predicate, w_cnt)
    _active_filter_out = []
    try:
        nox.thread.pool_run(w_cnt, _filter_pool_entry)
        return _active_filter_out
    finally:
        _active_filter_packets = []
        _active_filter_out = []

# ---------------------------------------------------------------------------
# 2. Parallel GroupBy Aggregation (disjoint per-worker packets)
# ---------------------------------------------------------------------------

def compute_agg_cell(agg_type: int, target_type: int, is_sample: bool, target_cells: list[Cell]) -> Cell:
    if agg_type == _AGG_COUNT_NON_MISSING:
        return cell_int(stat_count_non_missing(target_cells))
    if agg_type == _AGG_SUM:
        if target_type == TYPE_INT:
            return cell_int(stat_sum_int(target_cells, "groupby.agg_sum"))
        if target_type == TYPE_DECIMAL:
            return cell_decimal(stat_sum_decimal(target_cells))
        return cell_float(stat_sum(target_cells))
    if agg_type == _AGG_MEAN:
        if target_type == TYPE_DECIMAL:
            return cell_decimal(stat_mean_decimal(target_cells))
        return cell_float(stat_mean(target_cells))
    if agg_type == _AGG_MEDIAN:
        return cell_float(stat_median(target_cells))
    if agg_type == _AGG_STD:
        return cell_float(stat_std(target_cells, is_sample))
    if agg_type == _AGG_VARIANCE:
        return cell_float(stat_variance(target_cells, is_sample))
    if agg_type == _AGG_MIN:
        return stat_min(target_cells)
    if agg_type == _AGG_MAX:
        return stat_max(target_cells)
    raise AggregationError("unknown aggregation type: " + str(agg_type))

def compute_agg_slice(group_keys: list[list[Cell]], group_rows: list[list[list[Cell]]],
                      agg_types: list[int], target_indices: list[int], target_types: list[int],
                      is_samples: list[bool], start_g: int, end_g: int) -> list[list[Cell]]:
    slice_out: list[list[Cell]] = []
    num_aggs: int = len(agg_types)
    g_idx: int = start_g
    while g_idx < end_g:
        k_cells: list[Cell] = group_keys[g_idx]
        g_row_list: list[list[Cell]] = group_rows[g_idx]
        new_r: list[Cell] = []

        ki: int = 0
        num_keys: int = len(k_cells)
        while ki < num_keys:
            new_r.append(k_cells[ki])
            ki = ki + 1

        ai: int = 0
        while ai < num_aggs:
            a_type: int = agg_types[ai]
            if a_type == _AGG_COUNT:
                new_r.append(cell_int(len(g_row_list)))
            else:
                t_idx: int = target_indices[ai]
                target_cells: list[Cell] = []
                ri: int = 0
                num_g_rows: int = len(g_row_list)
                while ri < num_g_rows:
                    target_cells.append(g_row_list[ri][t_idx])
                    ri = ri + 1
                new_r.append(compute_agg_cell(a_type, target_types[ai], is_samples[ai], target_cells))
            ai = ai + 1

        slice_out.append(new_r)
        g_idx = g_idx + 1
    return slice_out

class _AggSlicePacket:
    group_keys: list[list[Cell]]
    group_rows: list[list[list[Cell]]]
    agg_types: list[int]
    target_indices: list[int]
    target_types: list[int]
    is_samples: list[bool]

    def __init__(self: _AggSlicePacket, group_keys: list[list[Cell]], group_rows: list[list[list[Cell]]],
                 agg_types: list[int], target_indices: list[int], target_types: list[int],
                 is_samples: list[bool]) -> None:
        self.group_keys = group_keys
        self.group_rows = group_rows
        self.agg_types = agg_types
        self.target_indices = target_indices
        self.target_types = target_types
        self.is_samples = is_samples

class _AggTaskHandle:
    t: Task[list[list[Cell]]]

    def __init__(self: _AggTaskHandle, t: Task[list[list[Cell]]]) -> None:
        self.t = t

_active_agg_packets: list[_AggSlicePacket] = []
_active_agg_out: list[list[Cell]] = []

async def _agg_slice_worker(pkt: _AggSlicePacket) -> list[list[Cell]]:
    return compute_agg_slice(pkt.group_keys, pkt.group_rows, pkt.agg_types, pkt.target_indices, pkt.target_types, pkt.is_samples, 0, len(pkt.group_keys))

async def _agg_pool_entry() -> None:
    handles: list[_AggTaskHandle] = []
    pi: int = 0
    while pi < len(_active_agg_packets):
        pkt: _AggSlicePacket = _active_agg_packets[pi]
        handles.append(_AggTaskHandle(spawn _agg_slice_worker(pkt)))
        pi = pi + 1

    merged: list[list[Cell]] = []
    ti: int = 0
    while ti < len(handles):
        part: list[list[Cell]] = await handles[ti].t
        j: int = 0
        while j < len(part):
            merged.append(part[j])
            j = j + 1
        ti = ti + 1
    _active_agg_out = merged

def parallel_compute_agg_rows(group_keys: list[list[Cell]], group_rows: list[list[list[Cell]]],
                              agg_types: list[int], target_indices: list[int], target_types: list[int],
                              is_samples: list[bool], workers: int = 4) -> list[list[Cell]]:
    num_groups: int = len(group_keys)
    w_cnt: int = workers
    if w_cnt < 1:
        w_cnt = 1
    if w_cnt > num_groups:
        w_cnt = num_groups
    if num_groups < 2 or w_cnt <= 1:
        return compute_agg_slice(group_keys, group_rows, agg_types, target_indices, target_types, is_samples, 0, num_groups)

    packets: list[_AggSlicePacket] = []
    chunk: int = (num_groups + w_cnt - 1) // w_cnt
    w: int = 0
    while w < w_cnt:
        start_g: int = w * chunk
        if start_g < num_groups:
            end_g: int = start_g + chunk
            if end_g > num_groups:
                end_g = num_groups
            gk_clone: list[list[Cell]] = []
            gr_clone: list[list[list[Cell]]] = []
            gi: int = start_g
            while gi < end_g:
                gk_clone.append(clone_isolated_row(group_keys[gi]))
                rows_clone: list[list[Cell]] = []
                g_src: list[list[Cell]] = group_rows[gi]
                ri: int = 0
                while ri < len(g_src):
                    rows_clone.append(clone_isolated_row(g_src[ri]))
                    ri = ri + 1
                gr_clone.append(rows_clone)
                gi = gi + 1
            packets.append(_AggSlicePacket(
                gk_clone,
                gr_clone,
                _clone_int_list(agg_types),
                _clone_int_list(target_indices),
                _clone_int_list(target_types),
                _clone_bool_list(is_samples)
            ))
        w = w + 1

    _active_agg_packets = packets
    _active_agg_out = []
    try:
        nox.thread.pool_run(w_cnt, _agg_pool_entry)
        return _active_agg_out
    finally:
        _active_agg_packets = []
        _active_agg_out = []

# ---------------------------------------------------------------------------
# 3. Parallel Window Partition Sorting (disjoint per-worker packets)
# ---------------------------------------------------------------------------

class _SortPartSlicePacket:
    local_rows: list[list[Cell]]
    local_to_orig: list[int]
    part_local_indices: list[list[int]]
    order_col_indices: list[int]
    asc_flags: list[bool]

    def __init__(self: _SortPartSlicePacket, local_rows: list[list[Cell]],
                 local_to_orig: list[int], part_local_indices: list[list[int]],
                 order_col_indices: list[int], asc_flags: list[bool]) -> None:
        self.local_rows = local_rows
        self.local_to_orig = local_to_orig
        self.part_local_indices = part_local_indices
        self.order_col_indices = order_col_indices
        self.asc_flags = asc_flags

class _SortPartTaskHandle:
    t: Task[list[list[int]]]

    def __init__(self: _SortPartTaskHandle, t: Task[list[list[int]]]) -> None:
        self.t = t

_active_sort_packets: list[_SortPartSlicePacket] = []
_active_sort_out: list[list[int]] = []

async def _sort_part_slice_worker(pkt: _SortPartSlicePacket) -> list[list[int]]:
    rows_local: list[list[Cell]] = []
    ri: int = 0
    while ri < len(pkt.local_rows):
        rows_local.append(clone_isolated_row(pkt.local_rows[ri]))
        ri = ri + 1
    ord_local: list[int] = _clone_int_list(pkt.order_col_indices)
    asc_local: list[bool] = _clone_bool_list(pkt.asc_flags)

    res: list[list[int]] = []
    pi: int = 0
    n_p: int = len(pkt.part_local_indices)
    while pi < n_p:
        loc_ind: list[int] = _clone_int_list(pkt.part_local_indices[pi])
        sorted_loc: list[int] = sort_partition_indices(rows_local, loc_ind, ord_local, asc_local)
        mapped: list[int] = []
        k: int = 0
        while k < len(sorted_loc):
            mapped.append(pkt.local_to_orig[sorted_loc[k]])
            k = k + 1
        res.append(mapped)
        pi = pi + 1
    return res

async def _sort_part_pool_entry() -> None:
    handles: list[_SortPartTaskHandle] = []
    pi: int = 0
    while pi < len(_active_sort_packets):
        pkt: _SortPartSlicePacket = _active_sort_packets[pi]
        handles.append(_SortPartTaskHandle(spawn _sort_part_slice_worker(pkt)))
        pi = pi + 1

    merged: list[list[int]] = []
    ti: int = 0
    while ti < len(handles):
        sub: list[list[int]] = await handles[ti].t
        si: int = 0
        while si < len(sub):
            merged.append(sub[si])
            si = si + 1
        ti = ti + 1
    _active_sort_out = merged

def parallel_sort_partitions(rows: list[list[Cell]], raw_partitions: list[list[int]],
                             order_col_indices: list[int], asc_flags: list[bool],
                             workers: int = 4) -> list[list[int]]:
    n_parts: int = len(raw_partitions)
    w_cnt: int = workers
    if w_cnt < 1:
        w_cnt = 1
    if w_cnt > n_parts:
        w_cnt = n_parts
    if n_parts < 2 or w_cnt <= 1:
        res: list[list[int]] = []
        p_i: int = 0
        while p_i < n_parts:
            res.append(sort_partition_indices(rows, raw_partitions[p_i], order_col_indices, asc_flags))
            p_i = p_i + 1
        return res

    packets: list[_SortPartSlicePacket] = []
    chunk: int = (n_parts + w_cnt - 1) // w_cnt
    w: int = 0
    while w < w_cnt:
        start_p: int = w * chunk
        if start_p < n_parts:
            end_p: int = start_p + chunk
            if end_p > n_parts:
                end_p = n_parts
            local_rows: list[list[Cell]] = []
            local_to_orig: list[int] = []
            part_loc: list[list[int]] = []
            pi: int = start_p
            while pi < end_p:
                src_ind: list[int] = raw_partitions[pi]
                l_copy: list[int] = []
                ki: int = 0
                while ki < len(src_ind):
                    orig_row_idx: int = src_ind[ki]
                    loc_row_idx: int = len(local_rows)
                    local_rows.append(clone_isolated_row(rows[orig_row_idx]))
                    local_to_orig.append(orig_row_idx)
                    l_copy.append(loc_row_idx)
                    ki = ki + 1
                part_loc.append(l_copy)
                pi = pi + 1
            packets.append(_SortPartSlicePacket(
                local_rows,
                local_to_orig,
                part_loc,
                _clone_int_list(order_col_indices),
                _clone_bool_list(asc_flags)
            ))
        w = w + 1

    _active_sort_packets = packets
    _active_sort_out = []
    try:
        nox.thread.pool_run(w_cnt, _sort_part_pool_entry)
        return _active_sort_out
    finally:
        _active_sort_packets = []
        _active_sort_out = []
