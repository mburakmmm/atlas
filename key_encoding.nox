# key_encoding.nox — Canonical hash key encoding for Atlas Join and GroupBy.

__all__: list[str] = ["cell_hash_key", "composite_hash_key"]

import nox.decimal
from nox.decimal import Decimal
import values
from values import Cell, TYPE_NULL, TYPE_INT, TYPE_FLOAT, TYPE_STR, TYPE_BOOL, TYPE_DECIMAL, TYPE_DATETIME, is_nan, is_inf

def cell_hash_key(c: Cell) -> str:
    if c.is_missing():
        return "N"
    if c.kind == TYPE_INT:
        return "I:" + str(c.as_int())
    if c.kind == TYPE_FLOAT:
        f_val: float = c.as_float()
        if not (f_val == f_val):
            return "F:nan"
        # If float represents an exact whole integer in 64-bit int range, normalize to "I:<int>"
        if f_val >= -9223372036854775808.0 and f_val < 9223372036854775808.0 and f_val == float(int(f_val)):
            return "I:" + str(int(f_val))
        return "F:" + str(f_val)
    if c.kind == TYPE_DECIMAL:
        d_norm: Decimal = c.as_decimal().normalize()
        if d_norm.exp >= 0:
            return "I:" + str(d_norm)
        try:
            df: float = d_norm.to_float()
            if not is_nan(df) and not is_inf(df):
                f_txt: str = str(df)
                if d_norm.compare(nox.decimal.parse(f_txt)) == 0:
                    return "F:" + f_txt
        except ValueError:
            pass
        return "D:" + str(d_norm)
    if c.kind == TYPE_DATETIME:
        return "DT:" + str(c.i)
    if c.kind == TYPE_STR:
        s_val: str = c.to_string()
        return "S" + str(len(s_val)) + ":" + s_val
    if c.kind == TYPE_BOOL:
        if c.as_bool():
            return "B:1"
        return "B:0"
    s_custom: str = c.to_string()
    return "U" + str(c.kind) + ":" + str(c.i) + ":" + str(len(s_custom)) + ":" + s_custom

def composite_hash_key(cells: list[Cell]) -> str:
    res: str = ""
    i: int = 0
    n: int = len(cells)
    while i < n:
        part: str = cell_hash_key(cells[i])
        res = res + "[" + str(len(part)) + "]" + part
        i = i + 1
    return res
