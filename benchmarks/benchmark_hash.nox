# benchmarks/benchmark_hash.nox — High-cardinality Hash GroupBy and Hash Join benchmarks.

import nox.time
import atlas
from atlas import Table, Schema, ColumnDef, Cell, cell_int, cell_str, cell_float, TYPE_INT, TYPE_STR, TYPE_FLOAT
from atlas import group_by, GroupedTable, agg_count, agg_sum, join_inner, join_left

print("==========================================================================")
print("Atlas v0.6.0 High-Cardinality & Hash Join Algorithmic Benchmark")
print("==========================================================================")

# 1. High-Cardinality GroupBy (10,000 unique groups out of 10,000 rows)
print("\n[Scenario 1] High-Cardinality Hash GroupBy (10,000 unique groups)...")
s1: Schema = Schema([ColumnDef("key", TYPE_STR), ColumnDef("val", TYPE_FLOAT)])
rows1: list[list[Cell]] = []
i: int = 0
n1: int = 10000
while i < n1:
    rows1.append([cell_str("k_" + str(i)), cell_float(1.5)])
    i = i + 1

t1: Table = Table(s1, rows1)

# Warmup run
g_warm: GroupedTable = group_by(t1, ["key"])

# Timed run
t0: int = nox.time.now_ms()
g: GroupedTable = group_by(t1, ["key"])
res1: Table = g.aggregate([agg_count("cnt"), agg_sum("val", "sum_val")])
dur_grp: int = nox.time.now_ms() - t0

print("-> Grouped " + str(n1) + " rows into " + str(res1.row_count()) + " unique groups in " + str(dur_grp) + " ms (O(N) Hash GroupBy)")

# 2. Hash Join (10,000 rows x 10,000 rows)
print("\n[Scenario 2] Hash Join (10,000 rows x 10,000 rows)...")
s_left: Schema = Schema([ColumnDef("id", TYPE_INT), ColumnDef("info", TYPE_STR)])
s_right: Schema = Schema([ColumnDef("id", TYPE_INT), ColumnDef("score", TYPE_FLOAT)])

left_rows: list[list[Cell]] = []
right_rows: list[list[Cell]] = []

i = 0
n_join: int = 10000
while i < n_join:
    left_rows.append([cell_int(i), cell_str("info_" + str(i))])
    # 50% match
    if i % 2 == 0:
        right_rows.append([cell_int(i), cell_float(float(i) * 2.5)])
    i = i + 1

t_l: Table = Table(s_left, left_rows)
t_r: Table = Table(s_right, right_rows)

# Warmup run
w_join: Table = join_inner(t_l, t_r, ["id"])

# Timed run
t0 = nox.time.now_ms()
t_joined: Table = join_inner(t_l, t_r, ["id"])
dur_join: int = nox.time.now_ms() - t0

print("-> Hash Joined 10,000 x 5,000 rows -> " + str(t_joined.row_count()) + " matching rows in " + str(dur_join) + " ms (O(N + M) Hash Join)")

# 3. Hash Left Outer Join
t0 = nox.time.now_ms()
t_left_joined: Table = join_left(t_l, t_r, ["id"])
dur_left_join: int = nox.time.now_ms() - t0

print("-> Hash Left Joined 10,000 rows in " + str(dur_left_join) + " ms")

print("\n==========================================================================")
print("Hash Join & Hash GroupBy Algorithmic Benchmarks verified successfully!")
print("==========================================================================")
