# benchmarks/benchmark_window.nox — Rigorous 100,000 row window benchmark with control group.

import nox.time
import atlas
from atlas import Table, Schema, ColumnDef, Cell, cell_int, cell_str, WindowContext
from atlas import TYPE_INT, TYPE_STR

print("==========================================================================")
print("Atlas Window Function & Pipeline Benchmark (100,000 synthetic rows)")
print("==========================================================================")

t0: int = nox.time.now_ms()
s: Schema = Schema([
    ColumnDef("id", TYPE_INT),
    ColumnDef("dept", TYPE_STR),
    ColumnDef("val", TYPE_INT)
])

rows: list[list[Cell]] = []
i: int = 0
n: int = 100000

while i < n:
    m: int = i % 10
    dept_name: str = "Dept_0"
    if m == 1:
        dept_name = "Dept_1"
    elif m == 2:
        dept_name = "Dept_2"
    elif m == 3:
        dept_name = "Dept_3"
    elif m == 4:
        dept_name = "Dept_4"
    elif m == 5:
        dept_name = "Dept_5"
    elif m == 6:
        dept_name = "Dept_6"
    elif m == 7:
        dept_name = "Dept_7"
    elif m == 8:
        dept_name = "Dept_8"
    elif m == 9:
        dept_name = "Dept_9"

    v: int = (i * 37) % 1000
    rows.append([cell_int(i), cell_str(dept_name), cell_int(v)])
    i = i + 1

t: Table = Table(s, rows)
gen_ms: int = nox.time.now_ms() - t0
print("[1] Ingested 100,000 rows into typed Table in " + str(gen_ms) + " ms")

# Scenario A: Single standalone window operation
t0 = nox.time.now_ms()
t_single: Table = t.with_row_number(output_col="rn", partition_by=["dept"], order_by=["val"], ascending=True)
single_ms: int = nox.time.now_ms() - t0
print("[Scenario A] Single window (row_number over 10 partitions): " + str(single_ms) + " ms")

# Scenario B: Control Group — 4 separate standalone window operations (re-partitions & re-sorts 4x)
t0 = nox.time.now_ms()
t_b: Table = t.with_row_number("rn", partition_by=["dept"], order_by=["val"]) \
              .with_rank("val", "rk", partition_by=["dept"]) \
              .with_cumulative_sum("val", "cumsum", partition_by=["dept"], order_by=["val"]) \
              .with_lag("val", "prev_val", 1, partition_by=["dept"], order_by=["val"], default_val=cell_int(0))
b_ms: int = nox.time.now_ms() - t0
print("[Scenario B] Control Group (4 standalone window operations, 4x sorts): " + str(b_ms) + " ms")

# Scenario C: WindowContext Pipeline (1 single partition & sort, lazy column buffer, 1 allocation)
t0 = nox.time.now_ms()
ctx: WindowContext = t.window(partition_by=["dept"], order_by=["val"], ascending=True)
ctx = ctx.with_row_number("rn")
ctx = ctx.with_rank("val", "rk")
ctx = ctx.with_cumulative_sum("val", "cumsum")
ctx = ctx.with_lag("val", "prev_val", 1, default_val=cell_int(0))
t_c: Table = ctx.to_table()
c_ms: int = nox.time.now_ms() - t0
print("[Scenario C] WindowContext Pipeline (4 window operations, 1x sort, lazy buffer): " + str(c_ms) + " ms")

# Verification & Empirical Speedup
if c_ms > 0:
    speedup: float = float(b_ms) / float(c_ms)
    print("--------------------------------------------------------------------------")
    print("Empirical Speedup (Scenario B / Scenario C): " + str(speedup) + "x")
print("Verified Table Row Count: " + str(t_c.row_count()) + ", Columns: " + str(t_c.column_count()))
print("==========================================================================")
print("Window Benchmark Completed Successfully!")
