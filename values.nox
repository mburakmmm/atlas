# values.nox — Typed cell value representation and missing value semantics for Atlas.

import errors
from errors import TypeConversionError, ShapeError

INT64_MAX: int = 9223372036854775807
INT64_MIN: int = -9223372036854775807 - 1

def checked_add_int64(a: int, b: int, context_msg: str = "") -> int:
    if b > 0 and a > INT64_MAX - b:
        msg: str = "integer overflow"
        if len(context_msg) > 0:
            msg = msg + " in " + context_msg
        raise ShapeError(msg)
    if b < 0 and a < INT64_MIN - b:
        msg: str = "integer underflow"
        if len(context_msg) > 0:
            msg = msg + " in " + context_msg
        raise ShapeError(msg)
    return a + b

TYPE_NULL: int = 0
TYPE_INT: int = 1
TYPE_FLOAT: int = 2
TYPE_STR: int = 3
TYPE_BOOL: int = 4

def _int_float_equals(i: int, f: float) -> bool:
    if not (f == f):
        return False
    if f < -9223372036854775808.0 or f >= 9223372036854775808.0:
        return False
    if f != float(int(f)):
        return False
    f_as_i: int = int(f)
    return i == f_as_i and float(f_as_i) == f

def _int_float_compare(i: int, f: float) -> int:
    if not (f == f):
        return -1
    if f >= 9223372036854775808.0:
        return -1
    if f < -9223372036854775808.0:
        return 1
    if f == float(int(f)):
        f_as_i: int = int(f)
        if i < f_as_i:
            return -1
        if i > f_as_i:
            return 1
        return 0
    f_trunc: int = int(f)
    if f > 0.0:
        if i <= f_trunc:
            return -1
        return 1
    else:
        if i >= f_trunc:
            return 1
        return -1

class Cell:
    kind: int
    i: int
    f: float
    s: str
    b: bool

    def __init__(self: Cell, kind: int, i: int, f: float, s: str, b: bool) -> None:
        self.kind = kind
        self.i = i
        self.f = f
        self.s = s
        self.b = b

    def is_missing(self: Cell) -> bool:

        return self.kind == TYPE_NULL

    def is_numeric(self: Cell) -> bool:

        return self.kind == TYPE_INT or self.kind == TYPE_FLOAT

    def as_int(self: Cell) -> int:

        if self.kind == TYPE_INT:
            return self.i
        if self.kind == TYPE_FLOAT:
            return int(self.f)
        if self.kind == TYPE_STR:
            try:
                return int(self.s)
            except ValueError:
                raise TypeConversionError("cannot convert string '" + self.s + "' to int")
        if self.kind == TYPE_BOOL:
            if self.b:
                return 1
            return 0
        raise TypeConversionError("cannot convert missing Cell to int")

    def as_float(self: Cell) -> float:

        if self.kind == TYPE_FLOAT:
            return self.f
        if self.kind == TYPE_INT:
            return float(self.i)
        if self.kind == TYPE_STR:
            try:
                return float(self.s)
            except ValueError:
                raise TypeConversionError("cannot convert string '" + self.s + "' to float")
        if self.kind == TYPE_BOOL:
            if self.b:
                return 1.0
            return 0.0
        raise TypeConversionError("cannot convert missing Cell to float")

    def as_str(self: Cell) -> str:

        return self.to_string()

    def as_bool(self: Cell) -> bool:

        if self.kind == TYPE_BOOL:
            return self.b
        if self.kind == TYPE_INT:
            return self.i != 0
        if self.kind == TYPE_FLOAT:
            return self.f != 0.0
        if self.kind == TYPE_STR:
            if self.s == "true" or self.s == "True" or self.s == "1" or self.s == "yes":
                return True
            if self.s == "false" or self.s == "False" or self.s == "0" or self.s == "no":
                return False
            raise TypeConversionError("cannot convert string '" + self.s + "' to bool")
        raise TypeConversionError("cannot convert missing Cell to bool")

    def to_string(self: Cell) -> str:

        if self.kind == TYPE_NULL:
            return ""
        if self.kind == TYPE_INT:
            return str(self.i)
        if self.kind == TYPE_FLOAT:
            return str(self.f)
        if self.kind == TYPE_STR:
            return self.s
        if self.kind == TYPE_BOOL:
            if self.b:
                return "true"
            return "false"
        return ""

    def equals(self: Cell, other: Cell) -> bool:

        if self.kind == TYPE_NULL or other.kind == TYPE_NULL:
            return self.kind == other.kind
        # Direct 64-bit integer equality without IEEE-754 float precision loss:
        if self.kind == TYPE_INT and other.kind == TYPE_INT:
            return self.i == other.i
        if self.kind == TYPE_FLOAT and other.kind == TYPE_FLOAT:
            s_nan: bool = not (self.f == self.f)
            o_nan: bool = not (other.f == other.f)
            if s_nan and o_nan:
                return True
            if s_nan or o_nan:
                return False
            return self.f == other.f
        if self.kind == TYPE_INT and other.kind == TYPE_FLOAT:
            return _int_float_equals(self.i, other.f)
        if self.kind == TYPE_FLOAT and other.kind == TYPE_INT:
            return _int_float_equals(other.i, self.f)
        if self.kind != other.kind:
            return False
        if self.kind == TYPE_STR:
            return self.s == other.s
        if self.kind == TYPE_BOOL:
            return self.b == other.b
        return self.i == other.i and self.s == other.s and self.b == other.b

    def compare(self: Cell, other: Cell, nulls_first: bool = False) -> int:

        # Returns -1 if self < other, 0 if equal, 1 if self > other
        if self.is_missing() and other.is_missing():
            return 0
        if self.is_missing():
            if nulls_first:
                return -1
            return 1
        if other.is_missing():
            if nulls_first:
                return 1
            return -1

        # Global NaN sorting: NaN sorts last across ALL types (int, float, str, bool, etc.)
        self_nan: bool = self.kind == TYPE_FLOAT and not (self.f == self.f)
        other_nan: bool = other.kind == TYPE_FLOAT and not (other.f == other.f)
        if self_nan and other_nan:
            return 0
        if self_nan:
            return 1 # NaN sorts last
        if other_nan:
            return -1

        # Direct 64-bit integer comparison without float conversion:
        if self.kind == TYPE_INT and other.kind == TYPE_INT:
            if self.i < other.i:
                return -1
            if self.i > other.i:
                return 1
            return 0

        if self.kind == TYPE_FLOAT and other.kind == TYPE_FLOAT:
            if self.f < other.f:
                return -1
            if self.f > other.f:
                return 1
            return 0

        if self.kind == TYPE_INT and other.kind == TYPE_FLOAT:
            return _int_float_compare(self.i, other.f)

        if self.kind == TYPE_FLOAT and other.kind == TYPE_INT:
            return -_int_float_compare(other.i, self.f)

        if self.kind == TYPE_STR and other.kind == TYPE_STR:
            if self.s < other.s:
                return -1
            if self.s > other.s:
                return 1
            return 0

        if self.kind == TYPE_BOOL and other.kind == TYPE_BOOL:
            if not self.b and other.b:
                return -1
            if self.b and not other.b:
                return 1
            return 0

        s1: str = self.to_string()
        s2: str = other.to_string()
        if s1 < s2:
            return -1
        if s1 > s2:
            return 1
        return 0

def cell_null() -> Cell:
    return Cell(TYPE_NULL, 0, 0.0, "", False)

def cell_int(i: int) -> Cell:
    return Cell(TYPE_INT, i, 0.0, "", False)

def cell_float(f: float) -> Cell:
    return Cell(TYPE_FLOAT, 0, f, "", False)

def cell_str(s: str) -> Cell:
    return Cell(TYPE_STR, 0, 0.0, s, False)

def cell_bool(b: bool) -> Cell:
    return Cell(TYPE_BOOL, 0, 0.0, "", b)

def is_nan(f: float) -> bool:
    return not (f == f)

def is_inf(f: float) -> bool:
    return f >= 9223372036854775808.0 or f < -9223372036854775808.0

def float_nan() -> float:
    return 0.0 / 0.0

def float_inf() -> float:
    return 1.0 / 0.0

def float_neg_inf() -> float:
    return -1.0 / 0.0

def cell_nan() -> Cell:
    return cell_float(float_nan())

def cell_inf() -> Cell:
    return cell_float(float_inf())

def cell_neg_inf() -> Cell:
    return cell_float(float_neg_inf())

def parse_cell(text: str, target_type: int, blank_is_missing: bool = True) -> Cell:
    if blank_is_missing and text == "":
        return cell_null()
    if text == "null" or text == "NULL" or text == "NA" or text == "N/A" or text == "NaN":
        return cell_null()

    if target_type == TYPE_INT:
        try:
            return cell_int(int(text))
        except ValueError:
            raise TypeConversionError("cannot parse '" + text + "' as int")

    if target_type == TYPE_FLOAT:
        try:
            return cell_float(float(text))
        except ValueError:
            raise TypeConversionError("cannot parse '" + text + "' as float")

    if target_type == TYPE_BOOL:
        if text == "true" or text == "True" or text == "1" or text == "yes":
            return cell_bool(True)
        if text == "false" or text == "False" or text == "0" or text == "no":
            return cell_bool(False)
        raise TypeConversionError("cannot parse '" + text + "' as bool")

    if target_type == TYPE_STR:
        return cell_str(text)

    # Fallback to string if target_type is TYPE_NULL or unknown
    return cell_str(text)
