# delimited.nox — RFC 4180 compliant custom delimiter parser and serializer for Atlas.

import errors
from errors import CsvImportError, ShapeError, MissingValueError
import values
from values import Cell, cell_null, parse_cell, TYPE_NULL, TYPE_INT, TYPE_FLOAT, TYPE_STR, TYPE_BOOL
import schema
from schema import Schema, ColumnDef
import table
from table import Table
import csv_adapter
from csv_adapter import infer_schema

class CsvOptions:
    delimiter: str
    has_header: bool
    blank_is_missing: bool
    strict: bool
    safe_spreadsheet: bool
    max_record_bytes: int

    def __init__(self: CsvOptions, delimiter: str = ",", has_header: bool = True, blank_is_missing: bool = True, strict: bool = False, safe_spreadsheet: bool = False, max_record_bytes: int = 10485760) -> None:
        self.delimiter = delimiter
        self.has_header = has_header
        self.blank_is_missing = blank_is_missing
        self.strict = strict
        self.safe_spreadsheet = safe_spreadsheet
        self.max_record_bytes = max_record_bytes

def csv_options(delimiter: str = ",", has_header: bool = True, blank_is_missing: bool = True, strict: bool = False, safe_spreadsheet: bool = False, max_record_bytes: int = 10485760) -> CsvOptions:
    return CsvOptions(delimiter, has_header, blank_is_missing, strict, safe_spreadsheet, max_record_bytes)

def parse_delimited(text: str, delimiter: str = ",", strict: bool = False) -> list[list[str]]:
    rows: list[list[str]] = []
    if len(text) == 0:
        return rows

    cur_row: list[str] = []
    cur_field: str = ""
    in_quotes: bool = False
    after_quote: bool = False
    i: int = 0
    n: int = len(text)
    delim_len: int = len(delimiter)
    if delim_len == 0:
        raise CsvImportError("delimiter cannot be empty")

    while i < n:
        ch: str = text[i]

        if in_quotes:
            if ch == "\"":
                if i + 1 < n and text[i + 1] == "\"":
                    cur_field = cur_field + "\""
                    i = i + 2
                else:
                    in_quotes = False
                    after_quote = True
                    i = i + 1
            else:
                cur_field = cur_field + ch
                i = i + 1
        elif after_quote:
            if delim_len == 1 and ch == delimiter:
                cur_row.append(cur_field)
                cur_field = ""
                after_quote = False
                i = i + 1
            elif delim_len > 1 and i + delim_len <= n and text[i:i + delim_len] == delimiter:
                cur_row.append(cur_field)
                cur_field = ""
                after_quote = False
                i = i + delim_len
            elif ch == "\r":
                if i + 1 < n and text[i + 1] == "\n":
                    i = i + 1
                cur_row.append(cur_field)
                cur_field = ""
                rows.append(cur_row)
                cur_row = []
                after_quote = False
                i = i + 1
            elif ch == "\n":
                cur_row.append(cur_field)
                cur_field = ""
                rows.append(cur_row)
                cur_row = []
                after_quote = False
                i = i + 1
            else:
                if strict:
                    raise CsvImportError("unexpected character after closing quote in strict mode: '" + ch + "'")
                cur_field = cur_field + ch
                after_quote = False
                i = i + 1
        else:
            if ch == "\"":
                if len(cur_field) == 0:
                    in_quotes = True
                    i = i + 1
                else:
                    if strict:
                        raise CsvImportError("unescaped quote in unquoted field in strict mode")
                    cur_field = cur_field + "\""
                    i = i + 1
            elif delim_len == 1 and ch == delimiter:
                cur_row.append(cur_field)
                cur_field = ""
                i = i + 1
            elif delim_len > 1 and i + delim_len <= n and text[i:i + delim_len] == delimiter:
                cur_row.append(cur_field)
                cur_field = ""
                i = i + delim_len
            elif ch == "\r":
                if i + 1 < n and text[i + 1] == "\n":
                    i = i + 1
                cur_row.append(cur_field)
                cur_field = ""
                rows.append(cur_row)
                cur_row = []
                i = i + 1
            elif ch == "\n":
                cur_row.append(cur_field)
                cur_field = ""
                rows.append(cur_row)
                cur_row = []
                i = i + 1
            else:
                cur_field = cur_field + ch
                i = i + 1

    if in_quotes:
        raise CsvImportError("unclosed quoted field in delimited text")

    if len(cur_field) > 0 or len(cur_row) > 0 or after_quote:
        cur_row.append(cur_field)
        rows.append(cur_row)

    return rows

def dump_delimited(rows: list[list[str]], delimiter: str = ",") -> str:
    res: str = ""
    r_idx: int = 0
    num_rows: int = len(rows)
    delim_len: int = len(delimiter)
    while r_idx < num_rows:
        row: list[str] = rows[r_idx]
        line: str = ""
        c_idx: int = 0
        num_cols: int = len(row)
        while c_idx < num_cols:
            field: str = row[c_idx]
            needs_quotes: bool = False
            k: int = 0
            flen: int = len(field)
            while k < flen:
                c: str = field[k]
                if c == "\"" or c == "\n" or c == "\r":
                    needs_quotes = True
                k = k + 1

            if delim_len == 1:
                k = 0
                while k < flen:
                    if field[k] == delimiter:
                        needs_quotes = True
                    k = k + 1
            else:
                if flen >= delim_len:
                    pos: int = 0
                    while pos + delim_len <= flen and not needs_quotes:
                        if field[pos:pos + delim_len] == delimiter:
                            needs_quotes = True
                        pos = pos + 1

            if needs_quotes:
                escaped: str = "\""
                k = 0
                while k < flen:
                    c = field[k]
                    if c == "\"":
                        escaped = escaped + "\"\""
                    else:
                        escaped = escaped + c
                    k = k + 1
                escaped = escaped + "\""
                line = line + escaped
            else:
                line = line + field

            if c_idx < num_cols - 1:
                line = line + delimiter
            c_idx = c_idx + 1

        res = res + line + "\n"
        r_idx = r_idx + 1
    return res

def read_delimited(text: str, delimiter: str = ",", has_header: bool = True, explicit_schema: Schema | None = None, blank_is_missing: bool = True, strict: bool = False) -> Table:
    raw_rows: list[list[str]] = parse_delimited(text, delimiter, strict)
    if len(raw_rows) == 0:
        if explicit_schema != None:
            empty_rows: list[list[Cell]] = []
            return Table(explicit_schema, empty_rows)
        empty_cols: list[ColumnDef] = []
        empty_schema: Schema = Schema(empty_cols)
        empty_table_rows: list[list[Cell]] = []
        return Table(empty_schema, empty_table_rows)

    headers: list[str] = []
    data_raw_rows: list[list[str]] = []

    if has_header:
        headers = raw_rows[0]
        i: int = 1
        n: int = len(raw_rows)
        while i < n:
            data_raw_rows.append(raw_rows[i])
            i = i + 1
    else:
        num_cols: int = len(raw_rows[0])
        i: int = 0
        while i < num_cols:
            headers.append("col_" + str(i))
            i = i + 1
        data_raw_rows = raw_rows

    # Validate ragged rows before schema inference
    r_check: int = 0
    num_data_rows: int = len(data_raw_rows)
    expected_num_cols: int = len(headers)
    while r_check < num_data_rows:
        if len(data_raw_rows[r_check]) != expected_num_cols:
            raise ShapeError("delimited row " + str(r_check) + " length mismatch: expected " + str(expected_num_cols) + ", got " + str(len(data_raw_rows[r_check])))
        r_check = r_check + 1

    s: Schema = Schema([])
    if explicit_schema != None:
        s = explicit_schema
    else:
        s = infer_schema(headers, data_raw_rows, blank_is_missing)

    expected_cols: int = s.column_count()
    typed_rows: list[list[Cell]] = []
    r_idx: int = 0

    while r_idx < num_data_rows:
        raw_r: list[str] = data_raw_rows[r_idx]
        if len(raw_r) != expected_cols:
            raise ShapeError("delimited row " + str(r_idx) + " length mismatch: expected " + str(expected_cols) + ", got " + str(len(raw_r)))

        typed_r: list[Cell] = []
        c_idx: int = 0
        while c_idx < expected_cols:
            col_def: ColumnDef = s.columns[c_idx]
            raw_cell: str = raw_r[c_idx]
            c: Cell = parse_cell(raw_cell, col_def.data_type, blank_is_missing)
            if not col_def.nullable and c.is_missing():
                raise MissingValueError("column '" + col_def.name + "' is not nullable, but missing value found at row " + str(r_idx))
            typed_r.append(c)
            c_idx = c_idx + 1

        typed_rows.append(typed_r)
        r_idx = r_idx + 1

    return Table(s, typed_rows)

def to_delimited(t: Table, delimiter: str = ",", include_header: bool = True, safe_spreadsheet: bool = False) -> str:
    string_rows: list[list[str]] = []
    if include_header:
        string_rows.append(t.column_names())

    r_idx: int = 0
    num_rows: int = t.row_count()
    num_cols: int = t.column_count()

    while r_idx < num_rows:
        row: list[Cell] = t.rows[r_idx]
        s_row: list[str] = []
        c_idx: int = 0
        while c_idx < num_cols:
            val_str: str = row[c_idx].to_string()
            if safe_spreadsheet and len(val_str) > 0:
                first_ch: str = val_str[0]
                if first_ch == "=" or first_ch == "+" or first_ch == "-" or first_ch == "@":
                    val_str = "'" + val_str
            s_row.append(val_str)
            c_idx = c_idx + 1
        string_rows.append(s_row)
        r_idx = r_idx + 1

    return dump_delimited(string_rows, delimiter)

def read_tsv(text: str, has_header: bool = True, explicit_schema: Schema | None = None, blank_is_missing: bool = True, strict: bool = False) -> Table:
    return read_delimited(text, "\t", has_header, explicit_schema, blank_is_missing, strict)

def to_tsv(t: Table, include_header: bool = True, safe_spreadsheet: bool = False) -> str:
    return to_delimited(t, "\t", include_header, safe_spreadsheet)

def read_delimited_options(text: str, options: CsvOptions, explicit_schema: Schema | None = None) -> Table:
    return read_delimited(text, options.delimiter, options.has_header, explicit_schema, options.blank_is_missing, options.strict)

def to_delimited_options(t: Table, options: CsvOptions) -> str:
    return to_delimited(t, options.delimiter, options.has_header, options.safe_spreadsheet)
