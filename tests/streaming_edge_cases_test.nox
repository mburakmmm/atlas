# tests/streaming_edge_cases_test.nox — Comprehensive edge-case verification for StreamingCsvReader.

import nox.test
import nox.fs
import errors
from errors import AtlasError, CsvImportError, ShapeError, AggregationError
import values
from values import Cell, TYPE_STR, TYPE_FLOAT, TYPE_INT, INT64_MAX
import groupby
from groupby import agg_sum
import schema
from schema import Schema, ColumnDef
import table
from table import Table
import delimited
from delimited import csv_options, CsvOptions
import streaming
from streaming import StreamingCsvReader, open_csv_stream, stream_count, stream_sum, stream_mean, stream_variance, stream_std

def test_quote_and_escaped_quote_split() -> None:
    # 1. Quote character split across byte chunks, escaped quotes across chunks
    # We use a very small chunk_bytes (4 bytes) to force splits everywhere!
    file_path: str = "temp_split_quotes.csv"
    content: str = "id,name,notes\r\n1,\"Alice\",\"Line 1\r\nLine 2\"\r\n2,\"Bob with \"\"escaped\"\" quotes\",ok\r\n3,Charlie,done\r\n"
    nox.fs.write_string(file_path, content)

    try:
        # Use chunk_bytes = 4 to guarantee chunk splits across quotes and newlines
        reader: StreamingCsvReader = StreamingCsvReader(file_path, csv_options(), None, 2, 4)
        tbl1: Table = reader.next_chunk()
        nox.test.assert_eq_int(tbl1.row_count(), 2, "tbl1 has 2 rows")
        assert tbl1.schema.columns[0].name == "id"
        assert tbl1.schema.columns[1].name == "name"
        assert tbl1.schema.columns[2].name == "notes"

        # Check row 1
        r0: list[Cell] = tbl1.row(0)
        assert r0[0].as_int() == 1
        assert r0[1].as_str() == "Alice"
        assert r0[2].as_str() == "Line 1\r\nLine 2"

        # Check row 2 with escaped quotes
        r1: list[Cell] = tbl1.row(1)
        assert r1[0].as_int() == 2
        assert r1[1].as_str() == "Bob with \"escaped\" quotes"
        assert r1[2].as_str() == "ok"

        # Read next chunk
        tbl2: Table = reader.next_chunk()
        nox.test.assert_eq_int(tbl2.row_count(), 1, "tbl2 has 1 row")
        r2: list[Cell] = tbl2.row(0)
        assert r2[0].as_int() == 3
        assert r2[1].as_str() == "Charlie"
        assert r2[2].as_str() == "done"

        reader.close()
    finally:
        if nox.fs.exists(file_path):
            nox.fs.remove_file(file_path)

def test_crlf_split_boundary() -> None:
    # 2. CRLF split across chunk boundary: \r at end of chunk 1, \n at start of chunk 2
    # "id,v\r\n1,10\r\n2,20\r\n"
    # Length of "id,v\r" is 5 bytes. With chunk_bytes=5, \r is at byte 4 (0-indexed), \n is at byte 0 of chunk 2!
    file_path: str = "temp_crlf_split.csv"
    content: str = "id,v\r\n1,10\r\n2,20\r\n"
    nox.fs.write_string(file_path, content)

    try:
        reader: StreamingCsvReader = StreamingCsvReader(file_path, csv_options(), None, 1, 5)
        t1: Table = reader.next_chunk()
        nox.test.assert_eq_int(t1.row_count(), 1, "t1 has 1 row")
        assert t1.row(0)[0].as_int() == 1
        assert t1.row(0)[1].as_int() == 10

        t2: Table = reader.next_chunk()
        nox.test.assert_eq_int(t2.row_count(), 1, "t2 has 1 row")
        assert t2.row(0)[0].as_int() == 2
        assert t2.row(0)[1].as_int() == 20

        assert not reader.has_next()
        reader.close()
    finally:
        if nox.fs.exists(file_path):
            nox.fs.remove_file(file_path)

def test_header_only_and_single_row() -> None:
    # 3. Header-only CSV
    h_path: str = "temp_header_only.csv"
    nox.fs.write_string(h_path, "col_a,col_b,col_c\n")
    try:
        reader: StreamingCsvReader = open_csv_stream(h_path, 10)
        tbl: Table = reader.next_chunk()
        nox.test.assert_eq_int(tbl.row_count(), 0, "0 data rows for header only")
        nox.test.assert_eq_int(tbl.column_count(), 3, "3 columns from header")
        assert tbl.schema.columns[0].name == "col_a"
        assert tbl.schema.columns[1].name == "col_b"
        assert tbl.schema.columns[2].name == "col_c"
        assert not reader.has_next()
        reader.close()

        count: int = stream_count(h_path)
        nox.test.assert_eq_int(count, 0, "stream_count of header only is 0")
    finally:
        if nox.fs.exists(h_path):
            nox.fs.remove_file(h_path)

    # 4. Single row after header
    s_path: str = "temp_single_row.csv"
    nox.fs.write_string(s_path, "x,y\n100,200\n")
    try:
        reader_s: StreamingCsvReader = open_csv_stream(s_path, 10)
        tbl_s: Table = reader_s.next_chunk()
        nox.test.assert_eq_int(tbl_s.row_count(), 1, "1 row streamed")
        assert tbl_s.row(0)[0].as_int() == 100
        assert tbl_s.row(0)[1].as_int() == 200
        assert not reader_s.has_next()
        reader_s.close()

        count_s: int = stream_count(s_path)
        nox.test.assert_eq_int(count_s, 1, "stream_count is 1")
    finally:
        if nox.fs.exists(s_path):
            nox.fs.remove_file(s_path)

def test_empty_csv() -> None:
    # 5. Empty CSV (0 bytes)
    e_path: str = "temp_empty.csv"
    nox.fs.write_string(e_path, "")
    try:
        reader: StreamingCsvReader = open_csv_stream(e_path, 10)
        tbl: Table = reader.next_chunk()
        nox.test.assert_eq_int(tbl.row_count(), 0, "empty table row count 0")
        nox.test.assert_eq_int(tbl.column_count(), 0, "empty table col count 0")
        assert not reader.has_next()
        reader.close()

        c: int = stream_count(e_path)
        nox.test.assert_eq_int(c, 0, "stream_count is 0")
        
        # Consistent AggregationError on empty data
        caught_mean: bool = False
        try:
            stream_mean(e_path, "col")
        except AggregationError as e:
            caught_mean = True
        assert caught_mean

        caught_var: bool = False
        try:
            stream_variance(e_path, "col")
        except AggregationError as e:
            caught_var = True
        assert caught_var
    finally:
        if nox.fs.exists(e_path):
            nox.fs.remove_file(e_path)

def test_parameter_validation() -> None:
    # 6. chunk_rows <= 0, chunk_bytes <= 0, max_record_bytes <= 0, delimiter == ""
    dummy: str = "temp_dummy.csv"
    nox.fs.write_string(dummy, "a,b\n1,2\n")
    try:
        caught_rows: bool = False
        try:
            StreamingCsvReader(dummy, csv_options(), None, 0, 1024)
        except AtlasError as e:
            caught_rows = True
        assert caught_rows

        caught_bytes: bool = False
        try:
            StreamingCsvReader(dummy, csv_options(), None, 10, -5)
        except AtlasError as e:
            caught_bytes = True
        assert caught_bytes

        caught_rec: bool = False
        try:
            StreamingCsvReader(dummy, csv_options(max_record_bytes=0), None, 10, 1024)
        except AtlasError as e:
            caught_rec = True
        assert caught_rec

        caught_delim: bool = False
        try:
            StreamingCsvReader(dummy, csv_options(delimiter=""), None, 10, 1024)
        except CsvImportError as e:
            caught_delim = True
        assert caught_delim
    finally:
        if nox.fs.exists(dummy):
            nox.fs.remove_file(dummy)

def test_max_record_bytes_limit() -> None:
    # 7. Exceeding max_record_bytes raises CsvImportError
    long_path: str = "temp_long_record.csv"
    # Create a record of 100 bytes while max_record_bytes is set to 30
    nox.fs.write_string(long_path, "id,desc\n1,\"This is a very long description that definitely exceeds thirty bytes of length for record testing!\"\n")
    try:
        opts: CsvOptions = csv_options(max_record_bytes=30)
        reader: StreamingCsvReader = StreamingCsvReader(long_path, opts, None, 10, 16)
        caught: bool = False
        try:
            reader.next_chunk()
        except CsvImportError as e:
            caught = True
        assert caught
        reader.close()
    finally:
        if nox.fs.exists(long_path):
            nox.fs.remove_file(long_path)

def test_stream_variance_and_std() -> None:
    # 8. Test stream_variance and stream_std online algorithm with chunks
    stats_path: str = "temp_streaming_stats.csv"
    # Values: 10, 20, 30, 40, 50
    # Mean: 30.0
    # Sample Variance: ((10-30)^2 + (20-30)^2 + (30-30)^2 + (40-30)^2 + (50-30)^2) / 4 = (400 + 100 + 0 + 100 + 400) / 4 = 1000 / 4 = 250.0
    # Population Variance: 1000 / 5 = 200.0
    # Sample Std: sqrt(250) = 15.811388300841896
    content: str = "num\n10\n20\n30\n40\n50\n"
    nox.fs.write_string(stats_path, content)
    try:
        # Stream in chunks of 2 rows
        opts: CsvOptions = csv_options()
        m: float = stream_mean(stats_path, "num", opts)
        assert m == 30.0

        var_sample: float = stream_variance(stats_path, "num", opts, True)
        assert var_sample == 250.0

        var_pop: float = stream_variance(stats_path, "num", opts, False)
        assert var_pop == 200.0

        std_sample: float = stream_std(stats_path, "num", opts, True)
        # Check within small tolerance
        diff: float = std_sample - 15.811388300841896
        if diff < 0.0:
            diff = 0.0 - diff
        assert diff < 0.0001
    finally:
        if nox.fs.exists(stats_path):
            nox.fs.remove_file(stats_path)

def test_resource_cleanup_on_error() -> None:
    # 9. Verify reader is closed even if an error is raised during aggregation
    err_path: str = "temp_err_resource.csv"
    nox.fs.write_string(err_path, "id,val\n1,10\n2,invalid_float_val\n")
    try:
        # Request stream_sum on non-existent column to trigger error inside try block
        caught: bool = False
        try:
            stream_sum(err_path, "non_existent_column")
        except ColumnNotFoundError as e:
            caught = True
        assert caught
        # File should be closed and safely deletable without handle lock
    finally:
        if nox.fs.exists(err_path):
            nox.fs.remove_file(err_path)

def test_explicit_schema_streaming() -> None:
    # 10. Streaming with explicit schema
    exp_path: str = "temp_explicit_schema.csv"
    nox.fs.write_string(exp_path, "code,val\n001,10.5\n002,20.0\n")
    try:
        # Enforce code as TYPE_STR (preserving leading zeros) and val as TYPE_FLOAT
        sch: Schema = Schema([
            ColumnDef("code", TYPE_STR, False),
            ColumnDef("val", TYPE_FLOAT, False),
        ])
        reader: StreamingCsvReader = open_csv_stream(exp_path, 10, csv_options(), sch)
        tbl: Table = reader.next_chunk()
        nox.test.assert_eq_int(tbl.row_count(), 2, "2 rows streamed")
        r0: list[Cell] = tbl.row(0)
        assert r0[0].as_str() == "001"
        assert r0[1].as_float() == 10.5

        r1: list[Cell] = tbl.row(1)
        assert r1[0].as_str() == "002"
        assert r1[1].as_float() == 20.0

        reader.close()
    finally:
        if nox.fs.exists(exp_path):
            nox.fs.remove_file(exp_path)

def test_multi_char_delimiter_chunk_split() -> None:
    # 11. Multi-character delimiter "||" split across 1-byte and 2-byte chunk boundaries
    mc_path: str = "temp_mc_delim.csv"
    content: str = "id||name||score\n1||Alice||95.5\n2||Bob||88.0\n"
    nox.fs.write_string(mc_path, content)
    try:
        # Test with chunk_bytes = 1 to split every single byte of "||"
        opts: CsvOptions = csv_options(delimiter="||")
        reader1: StreamingCsvReader = StreamingCsvReader(mc_path, opts, None, 2, 1)
        tbl1: Table = reader1.next_chunk()
        nox.test.assert_eq_int(tbl1.row_count(), 2, "tbl1 has 2 rows")
        assert tbl1.column_count() == 3
        assert tbl1.schema.columns[0].name == "id"
        assert tbl1.schema.columns[1].name == "name"
        assert tbl1.schema.columns[2].name == "score"
        assert tbl1.row(0)[0].as_int() == 1
        assert tbl1.row(0)[1].as_str() == "Alice"
        assert tbl1.row(0)[2].as_float() == 95.5
        assert tbl1.row(1)[0].as_int() == 2
        assert tbl1.row(1)[1].as_str() == "Bob"
        assert tbl1.row(1)[2].as_float() == 88.0
        assert not reader1.has_next()
        reader1.close()
    finally:
        if nox.fs.exists(mc_path):
            nox.fs.remove_file(mc_path)

def test_utf8_multibyte_record_limit() -> None:
    # 12. UTF-8 multi-byte characters counting true bytes against max_record_bytes
    # Turkish characters like "ğ" are 2 bytes, "😊" is 4 bytes
    utf8_path: str = "temp_utf8_limit.csv"
    # "id,val\n1,ğğğğğğğğğğ\n" -> 10 'ğ' = 20 UTF-8 bytes!
    # With header and prefix, total bytes of row 1 exceeds 25 bytes even though character count is under 20!
    nox.fs.write_string(utf8_path, "id,val\n1,ğğğğğğğğğğğğğğğğ\n")
    try:
        # Set max_record_bytes = 25. 16 'ğ' characters = 32 bytes (+ prefix = ~36 bytes).
        opts: CsvOptions = csv_options(max_record_bytes=25)
        reader: StreamingCsvReader = open_csv_stream(utf8_path, 10, opts)
        caught: bool = False
        try:
            reader.next_chunk()
        except CsvImportError as e:
            caught = True
        assert caught
        reader.close()
    finally:
        if nox.fs.exists(utf8_path):
            nox.fs.remove_file(utf8_path)

def test_large_chunk_bytes_bounded_memory() -> None:
    # 13. Huge chunk_bytes (50,000) with small chunk_rows (2) pauses parsing to bound memory
    bg_path: str = "temp_big_chunk.csv"
    content: str = "num,val\n"
    i: int = 1
    while i <= 10:
        content = content + str(i) + "," + str(i * 10) + "\n"
        i = i + 1
    nox.fs.write_string(bg_path, content)
    try:
        reader: StreamingCsvReader = StreamingCsvReader(bg_path, csv_options(), None, 2, 50000)
        chunks_seen: int = 0
        total_rows: int = 0
        while reader.has_next():
            chunk: Table = reader.next_chunk()
            chunks_seen = chunks_seen + 1
            total_rows = total_rows + chunk.row_count()
            assert chunk.row_count() <= 2
            # pending_rows must never bloat: at end of next_chunk it is bounded
            assert len(reader.pending_rows) <= 2
        reader.close()
        nox.test.assert_eq_int(total_rows, 10, "10 total rows processed")
        assert chunks_seen >= 5
    finally:
        if nox.fs.exists(bg_path):
            nox.fs.remove_file(bg_path)

def test_multichar_delim_bytes_accounting() -> None:
    # 14. Verify multi-character delimiter bytes are fully counted against max_record_bytes
    # Delimiter is "||||" (4 bytes). 4 delimiters = 16 bytes, total record = 22 bytes.
    # If max_record_bytes = 15, accurate counting MUST raise CsvImportError.
    mc_path: str = "temp_mc_bytes.csv"
    nox.fs.write_string(mc_path, "c1||||c2||||c3||||c4||||c5\na||||b||||c||||d||||e\n")
    try:
        opts: CsvOptions = csv_options(delimiter="||||", max_record_bytes=15)
        reader: StreamingCsvReader = open_csv_stream(mc_path, 10, opts)
        caught: bool = False
        try:
            reader.next_chunk()
        except CsvImportError as e:
            caught = True
        assert caught
        reader.close()
    finally:
        if nox.fs.exists(mc_path):
            nox.fs.remove_file(mc_path)

def test_eof_delimiter_state_machine_cases() -> None:
    # 15. Exhaustive EOF edge-case verification
    # Case A: File ending with single "|" when delimiter is "||" -> treated as field text
    f_a: str = "temp_eof_a.csv"
    nox.fs.write_string(f_a, "id||val\n1||abc|")
    try:
        reader_a: StreamingCsvReader = open_csv_stream(f_a, 10, csv_options(delimiter="||"))
        t_a: Table = reader_a.next_chunk()
        nox.test.assert_eq_int(t_a.row_count(), 1, "case A has 1 row")
        assert t_a.row(0)[0].as_int() == 1
        assert t_a.row(0)[1].as_str() == "abc|"
        reader_a.close()
    finally:
        if nox.fs.exists(f_a):
            nox.fs.remove_file(f_a)

    # Case B: File ending with full "||" -> trailing empty field
    f_b: str = "temp_eof_b.csv"
    nox.fs.write_string(f_b, "c1||c2||c3\n1||foo||")
    try:
        reader_b: StreamingCsvReader = open_csv_stream(f_b, 10, csv_options(delimiter="||"))
        t_b: Table = reader_b.next_chunk()
        nox.test.assert_eq_int(t_b.row_count(), 1, "case B has 1 row")
        nox.test.assert_eq_int(t_b.column_count(), 3, "case B has 3 columns")
        assert t_b.row(0)[0].as_int() == 1
        assert t_b.row(0)[1].as_str() == "foo"
        assert t_b.row(0)[2].is_missing()
        reader_b.close()
    finally:
        if nox.fs.exists(f_b):
            nox.fs.remove_file(f_b)

    # Case C: File ending immediately after closing quote -> valid record
    f_c: str = "temp_eof_c.csv"
    nox.fs.write_string(f_c, "id,val\n1,\"xyz\"")
    try:
        reader_c: StreamingCsvReader = open_csv_stream(f_c, 10)
        t_c: Table = reader_c.next_chunk()
        nox.test.assert_eq_int(t_c.row_count(), 1, "case C has 1 row")
        assert t_c.row(0)[0].as_int() == 1
        assert t_c.row(0)[1].as_str() == "xyz"
        reader_c.close()
    finally:
        if nox.fs.exists(f_c):
            nox.fs.remove_file(f_c)

    # Case D: File ending with incomplete/unclosed quoted field -> CsvImportError
    f_d: str = "temp_eof_d.csv"
    nox.fs.write_string(f_d, "id,val\n1,\"unclosed text")
    try:
        reader_d: StreamingCsvReader = open_csv_stream(f_d, 10)
        caught_d: bool = False
        try:
            reader_d.next_chunk()
        except CsvImportError as e:
            caught_d = True
        assert caught_d
        reader_d.close()
    finally:
        if nox.fs.exists(f_d):
            nox.fs.remove_file(f_d)

    # Case E: File ending with standalone "\r" -> single row end, no phantom row
    f_e: str = "temp_eof_e.csv"
    nox.fs.write_string(f_e, "id,val\n1,10\r")
    try:
        reader_e: StreamingCsvReader = open_csv_stream(f_e, 10)
        t_e: Table = reader_e.next_chunk()
        nox.test.assert_eq_int(t_e.row_count(), 1, "case E has exactly 1 row")
        assert t_e.row(0)[0].as_int() == 1
        assert t_e.row(0)[1].as_int() == 10
        assert not reader_e.has_next()
        reader_e.close()
    finally:
        if nox.fs.exists(f_e):
            nox.fs.remove_file(f_e)

    # Case F: File ending with "\r\n" -> single row end, no phantom row
    f_f: str = "temp_eof_f.csv"
    nox.fs.write_string(f_f, "id,val\n1,10\r\n")
    try:
        reader_f: StreamingCsvReader = open_csv_stream(f_f, 10)
        t_f: Table = reader_f.next_chunk()
        nox.test.assert_eq_int(t_f.row_count(), 1, "case F has exactly 1 row")
        assert t_f.row(0)[0].as_int() == 1
        assert t_f.row(0)[1].as_int() == 10
        assert not reader_f.has_next()
        reader_f.close()
    finally:
        if nox.fs.exists(f_f):
            nox.fs.remove_file(f_f)

def test_empty_file_explicit_schema_preservation() -> None:
    # Empty 0-byte file with explicit schema must preserve column names and types
    f_emp: str = "temp_empty_explicit_schema.csv"
    nox.fs.write_string(f_emp, "")
    try:
        sch: Schema = Schema([
            ColumnDef("code", TYPE_STR, False),
            ColumnDef("score", TYPE_FLOAT, True),
        ])
        reader: StreamingCsvReader = open_csv_stream(f_emp, 10, csv_options(), sch)
        t_emp: Table = reader.next_chunk()
        nox.test.assert_eq_int(t_emp.row_count(), 0, "empty file has 0 rows")
        nox.test.assert_eq_int(t_emp.column_count(), 2, "explicit schema column count preserved")
        assert t_emp.schema.columns[0].name == "code"
        nox.test.assert_eq_int(t_emp.schema.columns[0].data_type, TYPE_STR, "col 0 type str preserved")
        assert not t_emp.schema.columns[0].nullable
        assert t_emp.schema.columns[1].name == "score"
        nox.test.assert_eq_int(t_emp.schema.columns[1].data_type, TYPE_FLOAT, "col 1 type float preserved")
        assert t_emp.schema.columns[1].nullable
        assert not reader.has_next()
        reader.close()
    finally:
        if nox.fs.exists(f_emp):
            nox.fs.remove_file(f_emp)

def test_streaming_int64_overflow() -> None:
    f_ov: str = "temp_stream_int_overflow.csv"
    c_csv: str = "dept,amount\nEng,9223372036854775800\nEng,100\n"
    nox.fs.write_string(f_ov, c_csv)
    try:
        sch: Schema = Schema([ColumnDef("dept", TYPE_STR), ColumnDef("amount", TYPE_INT)])

        # 1. Test StreamingCsvReader.sum INT64 overflow
        reader: StreamingCsvReader = open_csv_stream(f_ov, 1, csv_options(), sch)
        caught_sum_ov: bool = False
        try:
            reader.sum("amount")
        except ShapeError:
            caught_sum_ov = True
        nox.test.assert_true(caught_sum_ov, "StreamingCsvReader.sum on INT64 overflow raises ShapeError")

        # 2. Test StreamingGroupedTable.aggregate([agg_sum(...)]) INT64 overflow
        reader2: StreamingCsvReader = open_csv_stream(f_ov, 1, csv_options(), sch)
        caught_grp_ov: bool = False
        try:
            reader2.group_by(["dept"]).aggregate([agg_sum("amount", "tot")])
        except ShapeError:
            caught_grp_ov = True
        nox.test.assert_true(caught_grp_ov, "StreamingGroupedTable.aggregate(sum) on INT64 overflow raises ShapeError")
    finally:
        if nox.fs.exists(f_ov):
            nox.fs.remove_file(f_ov)

test_quote_and_escaped_quote_split()
test_crlf_split_boundary()
test_header_only_and_single_row()
test_empty_csv()
test_parameter_validation()
test_max_record_bytes_limit()
test_stream_variance_and_std()
test_resource_cleanup_on_error()
test_explicit_schema_streaming()
test_empty_file_explicit_schema_preservation()
test_multi_char_delimiter_chunk_split()
test_utf8_multibyte_record_limit()
test_large_chunk_bytes_bounded_memory()
test_multichar_delim_bytes_accounting()
test_eof_delimiter_state_machine_cases()
test_streaming_int64_overflow()

print("streaming_edge_cases_test passed")
