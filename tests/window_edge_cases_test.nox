# tests/window_edge_cases_test.nox — Comprehensive edge-case tests for window functions.

import nox.test
import errors
from errors import ShapeError, ColumnNotFoundError, SortError, SchemaError
import values
from values import Cell, cell_int, cell_str, cell_float, cell_nan, cell_inf, cell_neg_inf, cell_null, TYPE_INT, TYPE_STR, TYPE_FLOAT
import schema
from schema import Schema, ColumnDef
import table
from table import Table
import window
from window import WindowContext, row_number, rank, dense_rank, lag, lead, cumulative_sum, moving_average

# 1. Edge Case: Empty Table
s_empty: Schema = Schema([
    ColumnDef("id", TYPE_INT),
    ColumnDef("val", TYPE_FLOAT)
])
t_empty: Table = Table(s_empty, [])

t_rn_empty: Table = row_number(t_empty, "rn")
nox.test.assert_eq_int(t_rn_empty.row_count(), 0, "empty table row_number has 0 rows")
nox.test.assert_eq_int(t_rn_empty.column_count(), 3, "empty table row_number has 3 columns")

t_rank_empty: Table = rank(t_empty, "val", "rank")
nox.test.assert_eq_int(t_rank_empty.row_count(), 0, "empty table rank has 0 rows")

t_cumsum_empty: Table = cumulative_sum(t_empty, "val", "cumsum")
nox.test.assert_eq_int(t_cumsum_empty.row_count(), 0, "empty table cumsum has 0 rows")

# 2. Edge Case: Single Row Partition
s_single: Schema = Schema([
    ColumnDef("dept", TYPE_STR),
    ColumnDef("amount", TYPE_INT)
])
t_single: Table = Table(s_single, [[cell_str("IT"), cell_int(500)]])

t_rn_single: Table = row_number(t_single, "rn", ["dept"])
nox.test.assert_eq_int(t_rn_single.rows[0][2].as_int(), 1, "single row rn is 1")

t_lag_single: Table = lag(t_single, "amount", "prev", 1, ["dept"], default_val=cell_int(-99))
nox.test.assert_eq_int(t_lag_single.rows[0][2].as_int(), -99, "single row lag returns default")

t_lead_single: Table = lead(t_single, "amount", "next", 1, ["dept"], default_val=cell_int(-99))
nox.test.assert_eq_int(t_lead_single.rows[0][2].as_int(), -99, "single row lead returns default")

t_cs_single: Table = cumulative_sum(t_single, "amount", "cs", ["dept"])
nox.test.assert_eq_int(t_cs_single.rows[0][2].as_int(), 500, "single row cumsum is 500")

# 3. Edge Case: lag & lead with offset > partition size
# Partition of 2 rows, offset = 5
r_p1: list[Cell] = [cell_str("IT"), cell_int(10)]
r_p2: list[Cell] = [cell_str("IT"), cell_int(20)]
t_two: Table = Table(s_single, [r_p1, r_p2])

t_lag_huge: Table = lag(t_two, "amount", "prev", 5, ["dept"], default_val=cell_int(-1))
nox.test.assert_eq_int(t_lag_huge.rows[0][2].as_int(), -1, "row 0 lag with huge offset is -1")
nox.test.assert_eq_int(t_lag_huge.rows[1][2].as_int(), -1, "row 1 lag with huge offset is -1")

t_lead_huge: Table = lead(t_two, "amount", "next", 5, ["dept"], default_val=cell_int(-1))
nox.test.assert_eq_int(t_lead_huge.rows[0][2].as_int(), -1, "row 0 lead with huge offset is -1")
nox.test.assert_eq_int(t_lead_huge.rows[1][2].as_int(), -1, "row 1 lead with huge offset is -1")

# 4. Edge Case: Descending Order (ascending=False)
# Amounts: 10, 20 -> Descending order is 20 (row 1), 10 (row 0)
t_rn_desc: Table = row_number(t_two, "rn", ["dept"], ["amount"], False)
# row 1 (amount=20) should have rn=1, row 0 (amount=10) should have rn=2
nox.test.assert_eq_int(t_rn_desc.rows[1][2].as_int(), 1, "highest amount has rn 1 in desc")
nox.test.assert_eq_int(t_rn_desc.rows[0][2].as_int(), 2, "lowest amount has rn 2 in desc")

# 5. Edge Case: All Ties (same values)
s_ties: Schema = Schema([
    ColumnDef("team", TYPE_STR),
    ColumnDef("score", TYPE_INT)
])
r_t1: list[Cell] = [cell_str("A"), cell_int(50)]
r_t2: list[Cell] = [cell_str("A"), cell_int(50)]
r_t3: list[Cell] = [cell_str("A"), cell_int(50)]
r_t4: list[Cell] = [cell_str("A"), cell_int(50)]
t_ties: Table = Table(s_ties, [r_t1, r_t2, r_t3, r_t4])

t_rank_ties: Table = rank(t_ties, "score", "rank", ["team"])
# All should have rank 1
nox.test.assert_eq_int(t_rank_ties.rows[0][2].as_int(), 1, "tie row 0 rank 1")
nox.test.assert_eq_int(t_rank_ties.rows[1][2].as_int(), 1, "tie row 1 rank 1")
nox.test.assert_eq_int(t_rank_ties.rows[2][2].as_int(), 1, "tie row 2 rank 1")
nox.test.assert_eq_int(t_rank_ties.rows[3][2].as_int(), 1, "tie row 3 rank 1")

# 6. Edge Case: Null and NaN Ordering in Window
s_nulls: Schema = Schema([
    ColumnDef("val", TYPE_FLOAT)
])
# 10.0, NaN, NULL, 5.0
r_n1: list[Cell] = [cell_float(10.0)]
r_n2: list[Cell] = [cell_nan()]
r_n3: list[Cell] = [cell_null()]
r_n4: list[Cell] = [cell_float(5.0)]
t_nulls: Table = Table(s_nulls, [r_n1, r_n2, r_n3, r_n4])

t_rn_nulls: Table = row_number(t_nulls, "rn", order_by=["val"], ascending=True)
# In ascending with nulls_last: 5.0 (row 3) -> 1, 10.0 (row 0) -> 2, NaN / NULL at the end
nox.test.assert_eq_int(t_rn_nulls.rows[3][1].as_int(), 1, "smallest finite float 5.0 is rn 1")
nox.test.assert_eq_int(t_rn_nulls.rows[0][1].as_int(), 2, "finite float 10.0 is rn 2")
nox.test.assert_eq_int(t_rn_nulls.rows[1][1].as_int(), 3, "NaN is rn 3")
nox.test.assert_eq_int(t_rn_nulls.rows[2][1].as_int(), 4, "NULL is rn 4 (nulls last)")

# 7. Edge Case: cumulative_sum Null Semantics (skip_null=True vs skip_null=False)
s_cs_null: Schema = Schema([
    ColumnDef("v", TYPE_INT)
])
# 10, 20, NULL, 40
r_c1: list[Cell] = [cell_int(10)]
r_c2: list[Cell] = [cell_int(20)]
r_c3: list[Cell] = [cell_null()]
r_c4: list[Cell] = [cell_int(40)]
t_cs_data: Table = Table(s_cs_null, [r_c1, r_c2, r_c3, r_c4])

# A) skip_null=True (default): retains current running sum on null
t_cs_skip: Table = cumulative_sum(t_cs_data, "v", "cs", skip_null=True)
nox.test.assert_eq_int(t_cs_skip.rows[0][1].as_int(), 10, "skip_null row 0 is 10")
nox.test.assert_eq_int(t_cs_skip.rows[1][1].as_int(), 30, "skip_null row 1 is 30")
nox.test.assert_eq_int(t_cs_skip.rows[2][1].as_int(), 30, "skip_null row 2 retains 30")
nox.test.assert_eq_int(t_cs_skip.rows[3][1].as_int(), 70, "skip_null row 3 is 70")

# B) skip_null=False: null propagation (null row yields null)
t_cs_noskip: Table = cumulative_sum(t_cs_data, "v", "cs_null", skip_null=False)
nox.test.assert_eq_int(t_cs_noskip.rows[0][1].as_int(), 10, "noskip row 0 is 10")
nox.test.assert_eq_int(t_cs_noskip.rows[1][1].as_int(), 30, "noskip row 1 is 30")
nox.test.assert_true(t_cs_noskip.rows[2][1].is_missing(), "noskip row 2 is NULL")
nox.test.assert_eq_int(t_cs_noskip.rows[3][1].as_int(), 70, "noskip row 3 resumes to 70")

# 8. Edge Case: moving_average Validation (min_periods > window_size)
caught_mavg_err: bool = False
try:
    moving_average(t_cs_data, "v", 3, "mavg", min_periods=4)
except ShapeError:
    caught_mavg_err = True
nox.test.assert_true(caught_mavg_err, "caught min_periods > window_size ShapeError")

# 9. Edge Case: INT64 Large Sum in cumulative_sum
s_large: Schema = Schema([
    ColumnDef("big", TYPE_INT)
])
# 9_000_000_000_000_000_000 + 100
r_lrg1: list[Cell] = [cell_int(9000000000000000000)]
r_lrg2: list[Cell] = [cell_int(100)]
t_large: Table = Table(s_large, [r_lrg1, r_lrg2])
t_cs_large: Table = cumulative_sum(t_large, "big", "cs_big")
nox.test.assert_eq_int(t_cs_large.rows[1][1].as_int(), 9000000000000000100, "int64 large sum preserved")

# 10. Edge Case: cumulative_sum null_policy="propagate"
t_cs_prop: Table = cumulative_sum(t_cs_data, "v", "cs_prop", null_policy="propagate")
nox.test.assert_eq_int(t_cs_prop.rows[0][1].as_int(), 10, "propagate row 0 is 10")
nox.test.assert_eq_int(t_cs_prop.rows[1][1].as_int(), 30, "propagate row 1 is 30")
nox.test.assert_true(t_cs_prop.rows[2][1].is_missing(), "propagate row 2 is NULL")
nox.test.assert_true(t_cs_prop.rows[3][1].is_missing(), "propagate row 3 remains NULL")

# 11. Edge Case: INT64 overflow & underflow checks raising ShapeError
r_of1: list[Cell] = [cell_int(9223372036854775800)]
r_of2: list[Cell] = [cell_int(100)]
t_of: Table = Table(s_large, [r_of1, r_of2])
caught_of: bool = False
try:
    cumulative_sum(t_of, "big", "cs_of")
except ShapeError:
    caught_of = True
nox.test.assert_true(caught_of, "cumulative_sum caught int64 overflow")

r_uf1: list[Cell] = [cell_int(-9223372036854775800)]
r_uf2: list[Cell] = [cell_int(-100)]
t_uf: Table = Table(s_large, [r_uf1, r_uf2])
caught_uf: bool = False
try:
    cumulative_sum(t_uf, "big", "cs_uf")
except ShapeError:
    caught_uf = True
nox.test.assert_true(caught_uf, "cumulative_sum caught int64 underflow")

# 12. Edge Case: moving_average all-null and long window
s_all_null: Schema = Schema([
    ColumnDef("fl", TYPE_FLOAT)
])
r_an1: list[Cell] = [cell_null()]
r_an2: list[Cell] = [cell_null()]
r_an3: list[Cell] = [cell_null()]
t_an: Table = Table(s_all_null, [r_an1, r_an2, r_an3])
t_mavg_an: Table = moving_average(t_an, "fl", 2, "mavg", min_periods=1)
nox.test.assert_true(t_mavg_an.rows[0][1].is_missing(), "all-null mavg row 0 is missing")
nox.test.assert_true(t_mavg_an.rows[1][1].is_missing(), "all-null mavg row 1 is missing")
nox.test.assert_true(t_mavg_an.rows[2][1].is_missing(), "all-null mavg row 2 is missing")

# Window size exceeding table length with min_periods=1
s_short: Schema = Schema([
    ColumnDef("fl", TYPE_FLOAT)
])
r_s1: list[Cell] = [cell_float(10.0)]
r_s2: list[Cell] = [cell_float(20.0)]
t_short: Table = Table(s_short, [r_s1, r_s2])
t_mavg_long: Table = moving_average(t_short, "fl", 10, "mavg", min_periods=1)
nox.test.assert_eq_float(t_mavg_long.rows[0][1].as_float(), 10.0, "mavg row 0 is 10.0")
nox.test.assert_eq_float(t_mavg_long.rows[1][1].as_float(), 15.0, "mavg row 1 is 15.0")

# 13. Edge Case: WindowContext Fluent Pipeline
s_pipe: Schema = Schema([
    ColumnDef("dept", TYPE_STR),
    ColumnDef("salary", TYPE_INT)
])
r_p1: list[Cell] = [cell_str("A"), cell_int(100)]
r_p2: list[Cell] = [cell_str("A"), cell_int(300)]
r_p3: list[Cell] = [cell_str("A"), cell_int(200)]
r_p4: list[Cell] = [cell_str("B"), cell_int(50)]
r_p5: list[Cell] = [cell_str("B"), cell_int(150)]
t_pipe_data: Table = Table(s_pipe, [r_p1, r_p2, r_p3, r_p4, r_p5])

# Chain: with_row_number -> with_rank -> with_dense_rank -> with_lag -> with_cumulative_sum
ctx: WindowContext = t_pipe_data.window(partition_by=["dept"], order_by=["salary"], ascending=True)
ctx = ctx.with_row_number("rn")
ctx = ctx.with_rank("salary", "rk")
ctx = ctx.with_dense_rank("salary", "drk")
ctx = ctx.with_lag("salary", "prev_sal", 1, default_val=cell_int(0))
ctx = ctx.with_cumulative_sum("salary", "c_sal")
w_res: Table = ctx.to_table()

nox.test.assert_eq_int(w_res.column_count(), 7, "pipeline produces 7 columns")
nox.test.assert_eq_int(w_res.row_count(), 5, "pipeline produces 5 rows")
# Verify Dept A order: 100 (row 0), 200 (row 2), 300 (row 1)
# Row 0 (A, 100): rn=1, rk=1, prev_sal=0, c_sal=100
nox.test.assert_eq_int(w_res.rows[0][2].as_int(), 1, "A 100 rn is 1")
nox.test.assert_eq_int(w_res.rows[0][5].as_int(), 0, "A 100 prev_sal default is 0")
nox.test.assert_eq_int(w_res.rows[0][6].as_int(), 100, "A 100 c_sal is 100")
# Row 2 (A, 200): rn=2, rk=2, prev_sal=100, c_sal=300
nox.test.assert_eq_int(w_res.rows[2][2].as_int(), 2, "A 200 rn is 2")
nox.test.assert_eq_int(w_res.rows[2][5].as_int(), 100, "A 200 prev_sal is 100")
nox.test.assert_eq_int(w_res.rows[2][6].as_int(), 300, "A 200 c_sal is 300")
# Row 1 (A, 300): rn=3, rk=3, prev_sal=200, c_sal=600
nox.test.assert_eq_int(w_res.rows[1][2].as_int(), 3, "A 300 rn is 3")
nox.test.assert_eq_int(w_res.rows[1][5].as_int(), 200, "A 300 prev_sal is 200")
nox.test.assert_eq_int(w_res.rows[1][6].as_int(), 600, "A 300 c_sal is 600")

# 14. Edge Case: with_rank and with_dense_rank order_col mismatch
caught_sort_err1: bool = False
try:
    # order_by is ["salary"], but calling with_rank("dept")
    t_pipe_data.window(order_by=["salary"]).with_rank("dept", "dept_rk")
except SortError:
    caught_sort_err1 = True
nox.test.assert_true(caught_sort_err1, "with_rank caught order_col mismatch with context order_by")

caught_sort_err2: bool = False
try:
    # No order_by specified in window, but calling with_rank
    t_pipe_data.window(partition_by=["dept"]).with_rank("salary", "sal_rk")
except SortError:
    caught_sort_err2 = True
nox.test.assert_true(caught_sort_err2, "with_rank caught missing order_by in context")

caught_sort_err3: bool = False
try:
    # No order_by specified in window, but calling with_dense_rank
    t_pipe_data.window(partition_by=["dept"]).with_dense_rank("salary", "sal_drk")
except SortError:
    caught_sort_err3 = True
nox.test.assert_true(caught_sort_err3, "with_dense_rank caught missing order_by in context")

# 15. Edge Case: Multi-column Order Evaluation in Rank & Dense Rank
s_multi: Schema = Schema([
    ColumnDef("dept", TYPE_STR),
    ColumnDef("lvl", TYPE_INT),
    ColumnDef("bonus", TYPE_INT)
])
r_m1: list[Cell] = [cell_str("Eng"), cell_int(1), cell_int(10)]
r_m2: list[Cell] = [cell_str("Eng"), cell_int(1), cell_int(20)]
r_m3: list[Cell] = [cell_str("Eng"), cell_int(2), cell_int(30)]
r_m4: list[Cell] = [cell_str("Sales"), cell_int(1), cell_int(40)]
t_multi: Table = Table(s_multi, [r_m1, r_m2, r_m3, r_m4])

ctx_multi: WindowContext = t_multi.window(order_by=["dept", "lvl"], ascending=True)
ctx_multi = ctx_multi.with_rank("dept", "rk")
ctx_multi = ctx_multi.with_dense_rank("dept", "drk")
t_res_multi: Table = ctx_multi.to_table()
# r_m1 and r_m2 are tied on both dept="Eng" and lvl=1 -> rk=1, drk=1
nox.test.assert_eq_int(t_res_multi.rows[0][3].as_int(), 1, "m1 rank 1")
nox.test.assert_eq_int(t_res_multi.rows[1][3].as_int(), 1, "m2 rank 1 (tie on dept & lvl)")
nox.test.assert_eq_int(t_res_multi.rows[0][4].as_int(), 1, "m1 dense_rank 1")
nox.test.assert_eq_int(t_res_multi.rows[1][4].as_int(), 1, "m2 dense_rank 1")
# r_m3 has lvl=2 -> rk=3 (gap!), drk=2
nox.test.assert_eq_int(t_res_multi.rows[2][3].as_int(), 3, "m3 rank 3 (skipped 2)")
nox.test.assert_eq_int(t_res_multi.rows[2][4].as_int(), 2, "m3 dense_rank 2 (no gap)")
# r_m4 has dept="Sales" -> rk=4, drk=3
nox.test.assert_eq_int(t_res_multi.rows[3][3].as_int(), 4, "m4 rank 4")
nox.test.assert_eq_int(t_res_multi.rows[3][4].as_int(), 3, "m4 dense_rank 3")

# 16. Edge Case: Differential Test between WindowContext Pipeline and Independent Calls
t_indep: Table = t_pipe_data.with_row_number("rn", partition_by=["dept"], order_by=["salary"])
t_indep = t_indep.with_rank("salary", "rk", partition_by=["dept"])
t_indep = t_indep.with_dense_rank("salary", "drk", partition_by=["dept"])
t_indep = t_indep.with_lag("salary", "prev_sal", 1, partition_by=["dept"], order_by=["salary"], default_val=cell_int(0))
t_indep = t_indep.with_cumulative_sum("salary", "c_sal", partition_by=["dept"], order_by=["salary"])

nox.test.assert_eq_int(w_res.row_count(), t_indep.row_count(), "pipeline row count matches independent")
nox.test.assert_eq_int(w_res.column_count(), t_indep.column_count(), "pipeline col count matches independent")

row_idx_check: int = 0
while row_idx_check < w_res.row_count():
    col_idx_check: int = 0
    while col_idx_check < w_res.column_count():
        p_cell: Cell = w_res.rows[row_idx_check][col_idx_check]
        i_cell: Cell = t_indep.rows[row_idx_check][col_idx_check]
        nox.test.assert_true(p_cell.equals(i_cell), "pipeline matches independent at row " + str(row_idx_check) + " col " + str(col_idx_check))
        col_idx_check = col_idx_check + 1
    row_idx_check = row_idx_check + 1

# 17. Edge Case: Pipeline Output Column Collision Checks
caught_schema_col1: bool = False
try:
    # Collide with existing column
    t_pipe_data.window().with_row_number("salary")
except SchemaError:
    caught_schema_col1 = True
nox.test.assert_true(caught_schema_col1, "pipeline caught collision with existing table column")

caught_schema_col2: bool = False
try:
    # Duplicate output column within pipeline
    t_pipe_data.window().with_row_number("rn").with_row_number("rn")
except SchemaError:
    caught_schema_col2 = True
nox.test.assert_true(caught_schema_col2, "pipeline caught duplicate column within pipeline")

# 18. Edge Case: Referencing Pending Pipeline Column raises SchemaError (Option A Contract)
caught_pending_ref1: bool = False
try:
    t_pipe_data.window(order_by=["salary"]).with_row_number("rn").with_lag("rn", "prev_rn")
except SchemaError:
    caught_pending_ref1 = True
nox.test.assert_true(caught_pending_ref1, "referencing pending column in with_lag raises SchemaError")

caught_pending_ref2: bool = False
try:
    t_pipe_data.window(order_by=["salary"]).with_row_number("rn").with_lead("rn", "next_rn")
except SchemaError:
    caught_pending_ref2 = True
nox.test.assert_true(caught_pending_ref2, "referencing pending column in with_lead raises SchemaError")

caught_pending_ref3: bool = False
try:
    t_pipe_data.window(order_by=["salary"]).with_row_number("rn").with_cumulative_sum("rn", "c_rn")
except SchemaError:
    caught_pending_ref3 = True
nox.test.assert_true(caught_pending_ref3, "referencing pending column in with_cumulative_sum raises SchemaError")

caught_pending_ref4: bool = False
try:
    t_pipe_data.window(order_by=["salary"]).with_row_number("rn").with_moving_average("rn", 2, "m_rn")
except SchemaError:
    caught_pending_ref4 = True
nox.test.assert_true(caught_pending_ref4, "referencing pending column in with_moving_average raises SchemaError")

# 19. Edge Case: Large Diverse Differential Equivalence Test (1,000 rows with mixed types & nulls)
s_lg: Schema = Schema([
    ColumnDef("id", TYPE_INT),
    ColumnDef("cat", TYPE_STR),
    ColumnDef("val_i", TYPE_INT),
    ColumnDef("val_f", TYPE_FLOAT)
])
rows_lg: list[list[Cell]] = []
idx_lg: int = 0
while idx_lg < 1000:
    c_cat: str = "A"
    if idx_lg % 5 == 1:
        c_cat = "B"
    elif idx_lg % 5 == 2:
        c_cat = "C"
    elif idx_lg % 5 == 3:
        c_cat = "D"
    elif idx_lg % 5 == 4:
        c_cat = "E"

    cell_i_v: Cell = cell_int((idx_lg * 17) % 500)
    if idx_lg % 11 == 0:
        cell_i_v = cell_null()

    cell_f_v: Cell = cell_float(float((idx_lg * 23) % 700) * 0.5)
    if idx_lg % 13 == 0:
        cell_f_v = cell_null()

    rows_lg.append([cell_int(idx_lg), cell_str(c_cat), cell_i_v, cell_f_v])
    idx_lg = idx_lg + 1

t_lg: Table = Table(s_lg, rows_lg)

# Independent calls on 1,000 rows
t_lg_indep: Table = t_lg.with_row_number("rn", partition_by=["cat"], order_by=["val_i"], ascending=True)
t_lg_indep = t_lg_indep.with_rank("val_i", "rk", partition_by=["cat"], ascending=True)
t_lg_indep = t_lg_indep.with_dense_rank("val_i", "drk", partition_by=["cat"], ascending=True)
t_lg_indep = t_lg_indep.with_lag("val_i", "lag_i", 1, partition_by=["cat"], order_by=["val_i"], ascending=True, default_val=cell_int(-1))
t_lg_indep = t_lg_indep.with_lead("val_f", "lead_f", 1, partition_by=["cat"], order_by=["val_i"], ascending=True, default_val=cell_float(-1.0))
t_lg_indep = t_lg_indep.with_cumulative_sum("val_i", "cumsum_i", partition_by=["cat"], order_by=["val_i"], ascending=True)
t_lg_indep = t_lg_indep.with_moving_average("val_f", 3, "mavg_f", partition_by=["cat"], order_by=["val_i"], ascending=True)

# WindowContext pipeline on 1,000 rows
ctx_lg: WindowContext = t_lg.window(partition_by=["cat"], order_by=["val_i"], ascending=True)
ctx_lg = ctx_lg.with_row_number("rn")
ctx_lg = ctx_lg.with_rank("val_i", "rk")
ctx_lg = ctx_lg.with_dense_rank("val_i", "drk")
ctx_lg = ctx_lg.with_lag("val_i", "lag_i", 1, default_val=cell_int(-1))
ctx_lg = ctx_lg.with_lead("val_f", "lead_f", 1, default_val=cell_float(-1.0))
ctx_lg = ctx_lg.with_cumulative_sum("val_i", "cumsum_i")
ctx_lg = ctx_lg.with_moving_average("val_f", 3, "mavg_f")
t_lg_pipe: Table = ctx_lg.to_table()

nox.test.assert_eq_int(t_lg_pipe.row_count(), 1000, "1,000 rows in pipeline table")
nox.test.assert_eq_int(t_lg_pipe.column_count(), 11, "11 columns in pipeline table")
nox.test.assert_eq_int(t_lg_pipe.row_count(), t_lg_indep.row_count(), "large row count matches")
nox.test.assert_eq_int(t_lg_pipe.column_count(), t_lg_indep.column_count(), "large col count matches")

r_lg: int = 0
while r_lg < 1000:
    c_lg: int = 0
    while c_lg < 11:
        p_c: Cell = t_lg_pipe.rows[r_lg][c_lg]
        i_c: Cell = t_lg_indep.rows[r_lg][c_lg]
        nox.test.assert_true(p_c.equals(i_c), "cell match at row " + str(r_lg) + " col " + str(c_lg))
        c_lg = c_lg + 1
    r_lg = r_lg + 1

print("window_edge_cases_test passed")
