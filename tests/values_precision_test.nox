# tests/values_precision_test.nox — 64-bit integer precision and single canonical field test.

import nox.test
import values
from values import Cell, cell_int, cell_float, cell_str, cell_bool, TYPE_INT, float_nan, float_inf, float_neg_inf, cell_nan, cell_inf, cell_neg_inf

# 2^53 = 9007199254740992
# In IEEE-754 double precision, 9007199254740992 and 9007199254740993 round to the same float!
n1: int = 9007199254740992
n2: int = 9007199254740993

c1: Cell = cell_int(n1)
c2: Cell = cell_int(n2)

# Direct integer equality must distinguish them:
assert not c1.equals(c2)
assert c1.compare(c2) == -1
assert c2.compare(c1) == 1

# Mixed int vs float precision tests:
# 9007199254740993 (int) vs 9007199254740992.0 (float) must NOT be equal:
cf1: Cell = cell_float(9007199254740992.0)
assert not c2.equals(cf1)
assert not cf1.equals(c2)
assert c2.compare(cf1) == 1
assert cf1.compare(c2) == -1

# Exact equal mixed int/float:
assert c1.equals(cf1)
assert cf1.equals(c1)
assert c1.compare(cf1) == 0
assert cf1.compare(c1) == 0

# Fractional float vs int:
c_frac: Cell = cell_float(5.5)
c_5: Cell = cell_int(5)
assert not c_5.equals(c_frac)
assert not c_frac.equals(c_5)
assert c_5.compare(c_frac) == -1
assert c_frac.compare(c_5) == 1

# Edge Cases for v0.6.2:
# 1. INT64_MAX vs 2^63.0: 9223372036854775807 vs 9223372036854775808.0
c_max_i: Cell = cell_int(9223372036854775807)
c_pow2_63_f: Cell = cell_float(9223372036854775808.0)
assert not c_max_i.equals(c_pow2_63_f)
assert not c_pow2_63_f.equals(c_max_i)
assert c_max_i.compare(c_pow2_63_f) == -1
assert c_pow2_63_f.compare(c_max_i) == 1

# 2. INT64_MIN vs -2^63.0: -9223372036854775808 vs -9223372036854775808.0
int64_min_val: int = -9223372036854775807 - 1
c_min_i: Cell = cell_int(int64_min_val)
c_min_f: Cell = cell_float(-9223372036854775808.0)
assert c_min_i.equals(c_min_f)
assert c_min_f.equals(c_min_i)
assert c_min_i.compare(c_min_f) == 0
assert c_min_f.compare(c_min_i) == 0

# 3. Near INT64_MAX multiple of 1024 exact float: 9223372036854774784
c_near_max_i: Cell = cell_int(9223372036854774784)
c_near_max_f: Cell = cell_float(9223372036854774784.0)
assert c_near_max_i.equals(c_near_max_f)
assert c_near_max_f.equals(c_near_max_i)
assert c_near_max_i.compare(c_near_max_f) == 0
assert c_near_max_f.compare(c_near_max_i) == 0

# 4. Positive and Negative Infinity via explicit functions
pos_inf_f: float = float_inf()
neg_inf_f: float = float_neg_inf()
c_pos_inf: Cell = cell_inf()
c_neg_inf: Cell = cell_neg_inf()

assert not c_5.equals(c_pos_inf)
assert not c_max_i.equals(c_pos_inf)
assert c_5.compare(c_pos_inf) == -1
assert c_max_i.compare(c_pos_inf) == -1
assert c_pos_inf.compare(c_max_i) == 1

assert not c_5.equals(c_neg_inf)
assert not c_min_i.equals(c_neg_inf)
assert c_5.compare(c_neg_inf) == 1
assert c_min_i.compare(c_neg_inf) == 1
assert c_neg_inf.compare(c_min_i) == -1

# 5. NaN Behavior via explicit portable functions & cross-type sorting
c_nan1: Cell = cell_nan()
c_nan2: Cell = cell_nan()
# Two NaNs equal each other in table operations:
assert c_nan1.equals(c_nan2)
assert c_nan1.compare(c_nan2) == 0

# Number vs NaN: not equal, number < NaN (NaN sorts last across ALL types):
assert not c_5.equals(c_nan1)
assert c_5.compare(c_nan1) == -1
assert c_nan1.compare(c_5) == 1

# Cross-type NaN sorting: String and Bool vs NaN:
c_str: Cell = cell_str("abc")
c_str_z: Cell = cell_str("zzz")
c_bool: Cell = cell_bool(True)

assert not c_str.equals(c_nan1)
assert c_str.compare(c_nan1) == -1
assert c_nan1.compare(c_str) == 1
assert c_str_z.compare(c_nan1) == -1
assert c_nan1.compare(c_str_z) == 1
assert c_bool.compare(c_nan1) == -1
assert c_nan1.compare(c_bool) == 1

# 6. Large integer vs representable fractional float:
c_large_i: Cell = cell_int(9007199254740993)
c_half_f: Cell = cell_float(2251799813685248.5)
assert not c_large_i.equals(c_half_f)
assert c_large_i.compare(c_half_f) == 1
assert c_half_f.compare(c_large_i) == -1

# Single canonical value test
# If directly instantiated with mismatching f, as_float() must still use i
bad_constructed: Cell = Cell(TYPE_INT, 100, 999.0, "", False)
assert bad_constructed.as_int() == 100
assert bad_constructed.as_float() == 100.0

print("values_precision_test passed")
