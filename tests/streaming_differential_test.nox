# tests/streaming_differential_test.nox — Differential property-based verification between offline and streaming parsers.

import nox.test
import nox.fs
import values
from values import Cell
import schema
from schema import Schema, ColumnDef
import table
from table import Table
import delimited
from delimited import read_delimited_options, csv_options, CsvOptions
import streaming
from streaming import StreamingCsvReader

def verify_tables_identical(t1: Table, t2: Table, label: str) -> None:
    nox.test.assert_eq_int(t1.row_count(), t2.row_count(), label + " row counts match")
    nox.test.assert_eq_int(t1.column_count(), t2.column_count(), label + " column counts match")
    
    # 1. Full Schema Equality: column name, data type, nullable, and ordering
    c: int = 0
    num_c: int = t1.column_count()
    while c < num_c:
        col1: ColumnDef = t1.schema.columns[c]
        col2: ColumnDef = t2.schema.columns[c]
        assert col1.name == col2.name
        nox.test.assert_eq_int(col1.data_type, col2.data_type, label + " col " + str(c) + " type")
        assert col1.nullable == col2.nullable
        c = c + 1

    # 2. Cell-by-Cell Value Equality
    r: int = 0
    num_r: int = t1.row_count()
    while r < num_r:
        c = 0
        while c < num_c:
            c1: Cell = t1.cell(r, c)
            c2: Cell = t2.cell(r, c)
            assert c1.equals(c2)
            c = c + 1
        r = r + 1

def run_differential_test(file_path: str, content: str, opts: CsvOptions, test_name: str) -> None:
    nox.fs.write_string(file_path, content)
    try:
        # 1. Parse offline using standard in-memory read_delimited_options
        offline_tbl: Table = read_delimited_options(content, opts)

        # 2. Test across 10 varied chunk sizes: from 1-byte stress tests to large buffers
        chunk_sizes: list[int] = [1, 2, 3, 5, 7, 11, 23, 64, 256, 1024]
        cs_idx: int = 0
        num_cs: int = len(chunk_sizes)

        while cs_idx < num_cs:
            csize: int = chunk_sizes[cs_idx]
            reader: StreamingCsvReader = StreamingCsvReader(file_path, opts, None, 2, csize)
            streamed_rows: list[list[Cell]] = []
            final_schema: Schema = Schema([])

            while reader.has_next():
                chunk_tbl: Table = reader.next_chunk()
                if final_schema.column_count() == 0:
                    final_schema = chunk_tbl.schema
                ri: int = 0
                nr: int = chunk_tbl.row_count()
                while ri < nr:
                    streamed_rows.append(chunk_tbl.row(ri))
                    ri = ri + 1

            reader.close()
            streamed_tbl: Table = Table(final_schema, streamed_rows)
            verify_tables_identical(offline_tbl, streamed_tbl, test_name + " (chunk_bytes=" + str(csize) + ")")
            cs_idx = cs_idx + 1
    finally:
        if nox.fs.exists(file_path):
            nox.fs.remove_file(file_path)

def test_standard_csv_differential() -> None:
    # Scenario A: Quotes, escaped quotes, multiline fields, CRLF
    content: str = "id,name,bio,score\r\n"
    content = content + "1,\"Alice\",\"Senior Engineer\r\nPlatform Team\",98.5\r\n"
    content = content + "2,\"Bob \"\"The Builder\"\"\",Simple bio,87.0\r\n"
    content = content + "3,\"Charlie, Jr.\",\"Line 1\nLine 2\nLine 3\",91.25\r\n"
    content = content + "4,Dave,\"Plain\",75.0\r\n"
    
    opts: CsvOptions = csv_options(delimiter=",")
    run_differential_test("temp_diff_standard.csv", content, opts, "Standard CSV Differential")

def test_multichar_delim_differential() -> None:
    # Scenario B: Multi-character delimiter "||"
    content: str = "code||city||population\n"
    content = content + "34||Istanbul||15840900\n"
    content = content + "06||Ankara||5747325\n"
    content = content + "35||Izmir||4425789\n"
    content = content + "26||Eskisehir||898369\n"

    opts: CsvOptions = csv_options(delimiter="||")
    run_differential_test("temp_diff_multichar.csv", content, opts, "Multi-char Delim || Differential")

def test_utf8_multibyte_differential() -> None:
    # Scenario C: Turkish UTF-8 characters and emojis
    content: str = "id,sehir,notlar,emoji\n"
    content = content + "1,İzmir,\"Ege'nin incisi\",🌊\n"
    content = content + "2,Ağrı,\"Dağı meşhur\",🏔️\n"
    content = content + "3,Şanlıurfa,\"Tarihi kent\",🏛️\n"
    content = content + "4,Eskişehir,\"Porsuk Çayı\",🛶\n"

    opts: CsvOptions = csv_options(delimiter=",")
    run_differential_test("temp_diff_utf8.csv", content, opts, "UTF-8 Multi-byte Differential")

def test_property_based_synthetic_generator() -> None:
    # Scenario D: Procedurally generated dataset with 50 diverse rows, multi-character delimiter "::"
    # and complex escaping to systematically verify: ParseOffline(x) == ParseStreaming(x, B)
    content: str = "rec_id::category::val_float::is_active::comments\r\n"
    i: int = 1
    while i <= 50:
        f_val: str = str(float(i) * 1.5)
        b_val: str = "true"
        if i % 2 == 0:
            b_val = "false"

        comment: str = "regular comment " + str(i)
        if i % 5 == 0:
            comment = "\"Comment with \"\"quotes\"\" and\r\nembedded newline for record " + str(i) + "\""
        elif i % 7 == 0:
            comment = "\"Comment with :: colons and , commas\""
        elif i % 11 == 0:
            comment = ""

        content = content + str(i) + "::Category_" + str(i % 4) + "::" + f_val + "::" + b_val + "::" + comment + "\r\n"
        i = i + 1

    opts: CsvOptions = csv_options(delimiter="::")
    run_differential_test("temp_diff_prop_gen.csv", content, opts, "Property-Based Synthetic Generator")

test_standard_csv_differential()
test_multichar_delim_differential()
test_utf8_multibyte_differential()
test_property_based_synthetic_generator()

print("streaming_differential_test passed")
