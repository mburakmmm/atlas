# tests/groupby_test.nox — Unit tests for GroupBy, multi-column grouping, and aggregate definitions.

import nox.test
import errors
from errors import ColumnNotFoundError, ShapeError
import values
from values import Cell, cell_int, cell_str, cell_float, cell_null, TYPE_INT, TYPE_STR, TYPE_FLOAT, INT64_MAX
import schema
from schema import Schema, ColumnDef
import table
from table import Table
import groupby
from groupby import GroupedTable, group_by, agg_count, agg_sum, agg_mean, agg_median, agg_std, agg_min, agg_max, agg_count_non_missing

s: Schema = Schema([ColumnDef("dept", TYPE_STR), ColumnDef("team", TYPE_STR), ColumnDef("salary", TYPE_FLOAT), ColumnDef("bonus", TYPE_FLOAT)])

# Engineering: Backend (100k, 10k), Frontend (80k, 5k), Backend (120k, 20k)
# Marketing: Growth (60k, null), Growth (70k, 15k)
r1: list[Cell] = [cell_str("Eng"), cell_str("Backend"), cell_float(100000.0), cell_float(10000.0)]
r2: list[Cell] = [cell_str("Eng"), cell_str("Frontend"), cell_float(80000.0), cell_float(5000.0)]
r3: list[Cell] = [cell_str("Eng"), cell_str("Backend"), cell_float(120000.0), cell_float(20000.0)]
r4: list[Cell] = [cell_str("Marketing"), cell_str("Growth"), cell_float(60000.0), cell_null()]
r5: list[Cell] = [cell_str("Marketing"), cell_str("Growth"), cell_float(70000.0), cell_float(15000.0)]

t: Table = Table(s, [r1, r2, r3, r4, r5])

# 1. Single-key grouping by dept
g_dept: GroupedTable = group_by(t, ["dept"])
nox.test.assert_eq_int(g_dept.group_count(), 2, "2 distinct departments")

res_dept: Table = g_dept.aggregate([agg_count("headcount"), agg_mean("salary", "avg_salary"), agg_sum("salary", "total_salary"), agg_min("salary", "min_salary"), agg_max("salary", "max_salary"), agg_count_non_missing("bonus", "bonus_recipients")])

nox.test.assert_eq_int(res_dept.row_count(), 2, "output table has 2 rows")
# Row 0: Eng
nox.test.assert_eq_str(res_dept.cell(0, 0).to_string(), "Eng", "Row 0 is Eng")
nox.test.assert_eq_int(res_dept.cell(0, 1).as_int(), 3, "Eng headcount 3")
nox.test.assert_eq_float(res_dept.cell(0, 2).as_float(), 100000.0, "Eng avg salary 100000")
nox.test.assert_eq_float(res_dept.cell(0, 3).as_float(), 300000.0, "Eng sum salary 300000")
nox.test.assert_eq_float(res_dept.cell(0, 4).as_float(), 80000.0, "Eng min salary 80000")
nox.test.assert_eq_float(res_dept.cell(0, 5).as_float(), 120000.0, "Eng max salary 120000")
nox.test.assert_eq_int(res_dept.cell(0, 6).as_int(), 3, "Eng all 3 have bonus")

# Row 1: Marketing
nox.test.assert_eq_str(res_dept.cell(1, 0).to_string(), "Marketing", "Row 1 is Marketing")
nox.test.assert_eq_int(res_dept.cell(1, 1).as_int(), 2, "Marketing headcount 2")
nox.test.assert_eq_float(res_dept.cell(1, 2).as_float(), 65000.0, "Marketing avg salary 65000")
nox.test.assert_eq_int(res_dept.cell(1, 6).as_int(), 1, "Marketing 1 non-missing bonus")

# 2. Multi-key grouping: ["dept", "team"]
# Groups: (Eng, Backend), (Eng, Frontend), (Marketing, Growth)
g_multi: GroupedTable = group_by(t, ["dept", "team"])
nox.test.assert_eq_int(g_multi.group_count(), 3, "3 distinct dept+team groups")

res_multi: Table = g_multi.aggregate([agg_count("size"), agg_mean("salary", "avg_sal")])
nox.test.assert_eq_int(res_multi.row_count(), 3, "res_multi 3 rows")
nox.test.assert_eq_str(res_multi.cell(0, 0).to_string(), "Eng", "group 0 dept")
nox.test.assert_eq_str(res_multi.cell(0, 1).to_string(), "Backend", "group 0 team")
nox.test.assert_eq_int(res_multi.cell(0, 2).as_int(), 2, "backend size 2")
nox.test.assert_eq_float(res_multi.cell(0, 3).as_float(), 110000.0, "backend avg sal (100k+120k)/2")

# 3. Convenience .count() method
counts_tab: Table = g_dept.count("emp_count")
nox.test.assert_eq_int(counts_tab.column_count(), 2, "dept and emp_count")
nox.test.assert_eq_int(counts_tab.cell(0, 1).as_int(), 3, "Eng count 3")
nox.test.assert_eq_int(counts_tab.cell(1, 1).as_int(), 2, "Marketing count 2")

# 4. Unknown key error
caught_err: bool = False
try:
    bad_grp: GroupedTable = group_by(t, ["nonexistent"])
except ColumnNotFoundError:
    caught_err = True
nox.test.assert_true(caught_err, "unknown group key raises ColumnNotFoundError")

# 5. INT64 Overflow Protection in groupby.agg_sum
s_gi: Schema = Schema([ColumnDef("group_key", TYPE_STR), ColumnDef("amount", TYPE_INT)])
t_gi: Table = Table(s_gi, [
    [cell_str("G1"), cell_int(100)],
    [cell_str("G1"), cell_int(200)],
    [cell_str("G2"), cell_int(500)]
])
g_int: GroupedTable = group_by(t_gi, ["group_key"])
res_int_sum: Table = g_int.aggregate([agg_sum("amount", "total")])
nox.test.assert_eq_int(res_int_sum.row_count(), 2, "2 groups")
nox.test.assert_eq_int(res_int_sum.schema.columns[1].data_type, TYPE_INT, "sum of int column is TYPE_INT")
nox.test.assert_eq_int(res_int_sum.cell(0, 1).as_int(), 300, "G1 sum is 300")
nox.test.assert_eq_int(res_int_sum.cell(1, 1).as_int(), 500, "G2 sum is 500")

t_gi_ov: Table = Table(s_gi, [
    [cell_str("G1"), cell_int(INT64_MAX - 5)],
    [cell_str("G1"), cell_int(10)]
])
g_int_ov: GroupedTable = group_by(t_gi_ov, ["group_key"])
caught_grp_sum_ov: bool = False
try:
    g_int_ov.aggregate([agg_sum("amount", "total")])
except ShapeError:
    caught_grp_sum_ov = True
nox.test.assert_true(caught_grp_sum_ov, "groupby.agg_sum on INT64 overflow raises ShapeError")

print("groupby_test passed")
