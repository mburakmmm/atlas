# tests/stats_test.nox — Verification of summary statistics, Welford's algorithm, and edge cases.

import nox.test
import nox.mathx
import errors
from errors import AggregationError, ShapeError
import values
from values import Cell, cell_int, cell_float, cell_null, checked_add_int64, checked_sub_int64, checked_mul_int64, checked_div_int64, INT64_MAX, INT64_MIN, TYPE_INT, float_inf, float_neg_inf, float_nan, is_nan, is_inf, is_pos_inf, is_neg_inf
import stats
from stats import stat_mean, stat_median, stat_variance, stat_std, stat_sum, stat_sum_int, stat_min, stat_max, stat_count, stat_count_non_missing, stat_count_missing
import schema
from schema import Schema, ColumnDef
import table
from table import Table

# 1. Simple dataset: [10, 20, 30, 40, 50]
c_odd: list[Cell] = [cell_int(10), cell_int(20), cell_int(30), cell_int(40), cell_int(50)]
nox.test.assert_eq_float(stat_mean(c_odd), 30.0, "mean of 10..50 is 30")
nox.test.assert_eq_float(stat_median(c_odd), 30.0, "median (odd) is 30")
nox.test.assert_eq_float(stat_sum(c_odd), 150.0, "sum is 150")
nox.test.assert_eq_int(stat_min(c_odd).as_int(), 10, "min is 10")
nox.test.assert_eq_int(stat_max(c_odd).as_int(), 50, "max is 50")
nox.test.assert_eq_int(stat_count(c_odd), 5, "count is 5")

# Sample variance of [10, 20, 30, 40, 50]:
# deviations: -20, -10, 0, 10, 20 -> sum of squares: 400 + 100 + 0 + 100 + 400 = 1000
# sample variance = 1000 / 4 = 250.0
# population variance = 1000 / 5 = 200.0
nox.test.assert_eq_float(stat_variance(c_odd, True), 250.0, "sample variance is 250.0")
nox.test.assert_eq_float(stat_variance(c_odd, False), 200.0, "population variance is 200.0")

# StdDev
# sqrt(250) approx 15.8113883
std_s: float = stat_std(c_odd, True)
nox.test.assert_true(std_s > 15.81 and std_s < 15.82, "sample stddev")

# 2. Even length dataset: [10, 20, 30, 40] -> median is (20+30)/2 = 25.0
c_even: list[Cell] = [cell_int(10), cell_int(20), cell_int(30), cell_int(40)]
nox.test.assert_eq_float(stat_median(c_even), 25.0, "median (even) is 25.0")

# 3. Missing values inside dataset: [10, null, 20, null, 30]
c_with_null: list[Cell] = [cell_int(10), cell_null(), cell_int(20), cell_null(), cell_int(30)]
nox.test.assert_eq_int(stat_count(c_with_null), 5, "total count is 5")
nox.test.assert_eq_int(stat_count_non_missing(c_with_null), 3, "non-missing count is 3")
nox.test.assert_eq_int(stat_count_missing(c_with_null), 2, "missing count is 2")
nox.test.assert_eq_float(stat_mean(c_with_null), 20.0, "mean ignores nulls")
nox.test.assert_eq_float(stat_median(c_with_null), 20.0, "median ignores nulls")

# 4. Single element dataset: [100]
c_single: list[Cell] = [cell_int(100)]
nox.test.assert_eq_float(stat_mean(c_single), 100.0, "mean of single is 100")
nox.test.assert_eq_float(stat_variance(c_single, False), 0.0, "population variance of single is 0")

caught_sample_single: bool = False
try:
    bad_var: float = stat_variance(c_single, True)
except AggregationError:
    caught_sample_single = True
nox.test.assert_true(caught_sample_single, "sample variance on single element must raise AggregationError")

# 5. Empty or all-missing dataset
c_all_null: list[Cell] = [cell_null(), cell_null()]
caught_empty_mean: bool = False
try:
    bad_mean: float = stat_mean(c_all_null)
except AggregationError:
    caught_empty_mean = True
nox.test.assert_true(caught_empty_mean, "mean on all-missing must raise AggregationError")

# 6. Numerical stability / cancellation sensitivity test: [1e8 + 1, 1e8 + 2, 1e8 + 3]
# Naive E[x^2] - E[x]^2 would lose precision on large numbers!
# Welford's algorithm computes variance of [1e8+1, 1e8+2, 1e8+3] accurately as sample variance = 1.0!
c_large: list[Cell] = [cell_float(100000001.0), cell_float(100000002.0), cell_float(100000003.0)]
var_large: float = stat_variance(c_large, True)
nox.test.assert_true(var_large > 0.999 and var_large < 1.001, "Welford computes variance of large numbers accurately (1.0)")

# 7. Checked INT64 Arithmetic & Overflow/Underflow Detection
nox.test.assert_eq_int(checked_add_int64(100, 200), 300, "checked_add_int64 normal addition")
nox.test.assert_eq_int(checked_add_int64(INT64_MAX, 0), INT64_MAX, "checked_add_int64 INT64_MAX + 0")
nox.test.assert_eq_int(checked_add_int64(INT64_MIN, 0), INT64_MIN, "checked_add_int64 INT64_MIN + 0")

caught_ov1: bool = False
try:
    checked_add_int64(INT64_MAX, 1, "test")
except ShapeError:
    caught_ov1 = True
nox.test.assert_true(caught_ov1, "INT64_MAX + 1 raises ShapeError")

caught_ov2: bool = False
try:
    checked_add_int64(INT64_MAX - 5, 10, "test")
except ShapeError:
    caught_ov2 = True
nox.test.assert_true(caught_ov2, "INT64_MAX - 5 + 10 raises ShapeError")

caught_un1: bool = False
try:
    checked_add_int64(INT64_MIN, -1, "test")
except ShapeError:
    caught_un1 = True
nox.test.assert_true(caught_un1, "INT64_MIN - 1 raises ShapeError")

caught_un2: bool = False
try:
    checked_add_int64(INT64_MIN + 5, -10, "test")
except ShapeError:
    caught_un2 = True
nox.test.assert_true(caught_un2, "INT64_MIN + 5 - 10 raises ShapeError")

# 8. stat_sum_int
nox.test.assert_eq_int(stat_sum_int([cell_int(10), cell_int(20), cell_int(30)]), 60, "stat_sum_int standard sum")

caught_stat_sum_ov: bool = False
try:
    stat_sum_int([cell_int(INT64_MAX - 3), cell_int(10)])
except ShapeError:
    caught_stat_sum_ov = True
nox.test.assert_true(caught_stat_sum_ov, "stat_sum_int raises ShapeError on overflow")

# 9. Table.sum_val Integer Overflow
s_ov: Schema = Schema([ColumnDef("val", TYPE_INT)])
t_ov: Table = Table(s_ov, [[cell_int(INT64_MAX)], [cell_int(1)]])
caught_tbl_sum_ov: bool = False
try:
    t_ov.sum_val("val")
except ShapeError:
    caught_tbl_sum_ov = True
nox.test.assert_true(caught_tbl_sum_ov, "Table.sum_val raises ShapeError on INT64 overflow")

# 10. Checked Subtraction, Multiplication, Division
nox.test.assert_eq_int(checked_sub_int64(10, 3), 7, "checked_sub_int64 10 - 3")
caught_sub_un: bool = False
try:
    checked_sub_int64(INT64_MIN, 1)
except ShapeError:
    caught_sub_un = True
nox.test.assert_true(caught_sub_un, "checked_sub_int64 INT64_MIN - 1 raises ShapeError")

caught_sub_ov: bool = False
try:
    checked_sub_int64(INT64_MAX, -1)
except ShapeError:
    caught_sub_ov = True
nox.test.assert_true(caught_sub_ov, "checked_sub_int64 INT64_MAX - (-1) raises ShapeError")

nox.test.assert_eq_int(checked_mul_int64(10, 5), 50, "checked_mul_int64 10 * 5")
caught_mul_ov1: bool = False
try:
    checked_mul_int64(INT64_MAX // 2 + 1, 2)
except ShapeError:
    caught_mul_ov1 = True
nox.test.assert_true(caught_mul_ov1, "checked_mul_int64 overflow raises ShapeError")

caught_mul_ov2: bool = False
try:
    checked_mul_int64(INT64_MIN, -1)
except ShapeError:
    caught_mul_ov2 = True
nox.test.assert_true(caught_mul_ov2, "checked_mul_int64 INT64_MIN * -1 raises ShapeError")

nox.test.assert_eq_int(checked_div_int64(100, 5), 20, "checked_div_int64 100 // 5")
caught_div_zero: bool = False
try:
    checked_div_int64(100, 0)
except ShapeError:
    caught_div_zero = True
nox.test.assert_true(caught_div_zero, "checked_div_int64 div by zero raises ShapeError")

caught_div_ov: bool = False
try:
    checked_div_int64(INT64_MIN, -1)
except ShapeError:
    caught_div_ov = True
nox.test.assert_true(caught_div_ov, "checked_div_int64 INT64_MIN // -1 raises ShapeError")

# 11. Neumaier Compensated Summation Catastrophic Cancellation Test
# Mathematically: 1e16 + 1.0 - 1e16 = 1.0
cells_canc: list[Cell] = [cell_float(10000000000000000.0), cell_float(1.0), cell_float(-10000000000000000.0)]
sum_canc: float = stat_sum(cells_canc)
nox.test.assert_eq_float(sum_canc, 1.0, "Neumaier compensated summation recovers 1.0 exactly after cancellation")

mean_canc: float = stat_mean(cells_canc)
expected_mean: float = 1.0 / 3.0
diff_mean: float = mean_canc - expected_mean
if diff_mean < 0.0:
    diff_mean = -diff_mean
nox.test.assert_true(diff_mean < 1e-12, "Neumaier mean accurately preserves 1/3")

# 12. Neumaier Summation with IEEE-754 Infinity & NaN Semantics
cells_inf_pos: list[Cell] = [cell_float(float_inf()), cell_float(1.0)]
nox.test.assert_true(stat_sum(cells_inf_pos) == float_inf(), "stat_sum([+Inf, 1.0]) == +Inf")
nox.test.assert_true(stat_mean(cells_inf_pos) == float_inf(), "stat_mean([+Inf, 1.0]) == +Inf")

cells_inf_neg: list[Cell] = [cell_float(float_neg_inf()), cell_float(1.0)]
nox.test.assert_true(stat_sum(cells_inf_neg) == float_neg_inf(), "stat_sum([-Inf, 1.0]) == -Inf")
nox.test.assert_true(stat_mean(cells_inf_neg) == float_neg_inf(), "stat_mean([-Inf, 1.0]) == -Inf")

cells_inf_both: list[Cell] = [cell_float(float_inf()), cell_float(float_neg_inf())]
nox.test.assert_true(is_nan(stat_sum(cells_inf_both)), "stat_sum([+Inf, -Inf]) is NaN")
nox.test.assert_true(is_nan(stat_mean(cells_inf_both)), "stat_mean([+Inf, -Inf]) is NaN")

cells_with_nan: list[Cell] = [cell_float(float_nan()), cell_float(1.0)]
nox.test.assert_true(is_nan(stat_sum(cells_with_nan)), "stat_sum([NaN, 1.0]) is NaN")
nox.test.assert_true(is_nan(stat_mean(cells_with_nan)), "stat_mean([NaN, 1.0]) is NaN")

print("stats_test passed")
