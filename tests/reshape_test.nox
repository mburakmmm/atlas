# tests/reshape_test.nox — Unit tests for table reshaping: melt, pivot, pivot_table.

import nox.test
import errors
from errors import ShapeError, ColumnNotFoundError, SchemaError
import values
from values import Cell, cell_str, cell_int, cell_float, cell_null, TYPE_INT, TYPE_FLOAT, TYPE_STR
import schema
from schema import Schema, ColumnDef
import table
from table import Table
import reshape
from reshape import melt, pivot, pivot_table

# 1. Setup Wide Table for Melt
# id, name, q1, q2
s_wide: Schema = Schema([
    ColumnDef("id", TYPE_INT),
    ColumnDef("name", TYPE_STR),
    ColumnDef("q1", TYPE_INT),
    ColumnDef("q2", TYPE_INT)
])

r_w1: list[Cell] = [cell_int(1), cell_str("Alice"), cell_int(100), cell_int(150)]
r_w2: list[Cell] = [cell_int(2), cell_str("Bob"), cell_int(200), cell_int(250)]
t_wide: Table = Table(s_wide, [r_w1, r_w2])

# Melt wide table
t_melted: Table = melt(t_wide, ["id", "name"], ["q1", "q2"], "quarter", "revenue")
# Expected 4 rows: (1, Alice, q1, 100), (1, Alice, q2, 150), (2, Bob, q1, 200), (2, Bob, q2, 250)
nox.test.assert_eq_int(t_melted.row_count(), 4, "melt produced 4 rows")
nox.test.assert_eq_int(t_melted.column_count(), 4, "melt produced 4 columns")
nox.test.assert_eq_str(t_melted.schema.columns[2].name, "quarter", "var_name is quarter")
nox.test.assert_eq_str(t_melted.schema.columns[3].name, "revenue", "value_name is revenue")

nox.test.assert_eq_str(t_melted.rows[0][2].as_str(), "q1", "first row is q1")
nox.test.assert_eq_int(t_melted.rows[0][3].as_int(), 100, "first row rev is 100")
nox.test.assert_eq_str(t_melted.rows[1][2].as_str(), "q2", "second row is q2")
nox.test.assert_eq_int(t_melted.rows[1][3].as_int(), 150, "second row rev is 150")

# Melt with default value_vars=None
t_melted_all: Table = melt(t_wide, ["id", "name"])
nox.test.assert_eq_int(t_melted_all.row_count(), 4, "default melt produced 4 rows")

# 2. Setup Long Table for Pivot & Pivot Table
# dept, quarter, revenue
s_long: Schema = Schema([
    ColumnDef("dept", TYPE_STR),
    ColumnDef("quarter", TYPE_STR),
    ColumnDef("revenue", TYPE_INT)
])

# Eng: Q1=100, Q2=200
# Sales: Q1=300, Q2=400
r_l1: list[Cell] = [cell_str("Eng"), cell_str("Q1"), cell_int(100)]
r_l2: list[Cell] = [cell_str("Eng"), cell_str("Q2"), cell_int(200)]
r_l3: list[Cell] = [cell_str("Sales"), cell_str("Q1"), cell_int(300)]
r_l4: list[Cell] = [cell_str("Sales"), cell_str("Q2"), cell_int(400)]
t_long: Table = Table(s_long, [r_l1, r_l2, r_l3, r_l4])

t_pivoted: Table = pivot(t_long, "dept", "quarter", "revenue")
# Expected 2 rows (Eng, Sales) and 3 cols (dept, Q1, Q2)
nox.test.assert_eq_int(t_pivoted.row_count(), 2, "pivot produced 2 rows")
nox.test.assert_eq_int(t_pivoted.column_count(), 3, "pivot produced 3 columns: dept, Q1, Q2")
nox.test.assert_eq_str(t_pivoted.rows[0][0].as_str(), "Eng", "Row 0 is Eng")
nox.test.assert_eq_int(t_pivoted.rows[0][1].as_int(), 100, "Eng Q1 is 100")
nox.test.assert_eq_int(t_pivoted.rows[0][2].as_int(), 200, "Eng Q2 is 200")
nox.test.assert_eq_str(t_pivoted.rows[1][0].as_str(), "Sales", "Row 1 is Sales")
nox.test.assert_eq_int(t_pivoted.rows[1][1].as_int(), 300, "Sales Q1 is 300")
nox.test.assert_eq_int(t_pivoted.rows[1][2].as_int(), 400, "Sales Q2 is 400")

# 3. Test Pivot Duplicate Error
r_l_dup: list[Cell] = [cell_str("Eng"), cell_str("Q1"), cell_int(999)]
t_long_dup: Table = Table(s_long, [r_l1, r_l2, r_l3, r_l4, r_l_dup])

caught_dup_error: bool = False
try:
    pivot(t_long_dup, "dept", "quarter", "revenue")
except ShapeError:
    caught_dup_error = True
nox.test.assert_true(caught_dup_error, "pivot caught duplicate error")

# Test Pivot Column Name Collision with index_col ("dept")
s_coll: Schema = Schema([
    ColumnDef("dept", TYPE_STR),
    ColumnDef("category", TYPE_STR),
    ColumnDef("val", TYPE_INT)
])
# Row has category == "dept" -> collides with index_col "dept"
r_coll: list[Cell] = [cell_str("Sales"), cell_str("dept"), cell_int(10)]
t_coll: Table = Table(s_coll, [r_coll])
caught_coll_error: bool = False
try:
    pivot(t_coll, "dept", "category", "val")
except SchemaError:
    caught_coll_error = True
nox.test.assert_true(caught_coll_error, "pivot caught column name collision with index_col")

# Test Pivot Empty String Column Error
r_empty_c: list[Cell] = [cell_str("Sales"), cell_str(""), cell_int(10)]
t_empty_c: Table = Table(s_coll, [r_empty_c])
caught_empty_col: bool = False
try:
    pivot(t_empty_c, "dept", "category", "val")
except SchemaError:
    caught_empty_col = True
nox.test.assert_true(caught_empty_col, "pivot caught empty string column error")

# 4. Test Pivot Table with Duplicate Aggregation
# Eng has two Q1 entries: 100 and 999.
# mean: (100 + 999) / 2 = 549.5
t_pt_mean: Table = pivot_table(t_long_dup, "dept", "quarter", "revenue", "mean")
nox.test.assert_eq_int(t_pt_mean.row_count(), 2, "pivot_table row count 2")
nox.test.assert_true(t_pt_mean.rows[0][1].as_float() == 549.5, "Eng Q1 mean is 549.5")

# sum: 100 + 999 = 1099
t_pt_sum: Table = pivot_table(t_long_dup, "dept", "quarter", "revenue", "sum")
nox.test.assert_eq_int(t_pt_sum.rows[0][1].as_int(), 1099, "Eng Q1 sum is 1099")

# count: 2
t_pt_count: Table = pivot_table(t_long_dup, "dept", "quarter", "revenue", "count")
nox.test.assert_eq_int(t_pt_count.rows[0][1].as_int(), 2, "Eng Q1 count is 2")

# max: 999
t_pt_max: Table = pivot_table(t_long_dup, "dept", "quarter", "revenue", "max")
nox.test.assert_eq_int(t_pt_max.rows[0][1].as_int(), 999, "Eng Q1 max is 999")

print("reshape_test passed")
