# tests/window_test.nox — Unit tests for Atlas window functions.

import nox.test
import errors
from errors import ColumnNotFoundError, ShapeError, SchemaError
import values
from values import Cell, cell_int, cell_str, cell_float, cell_null, TYPE_INT, TYPE_STR, TYPE_FLOAT
import schema
from schema import Schema, ColumnDef
import table
from table import Table
import window
from window import row_number, rank, dense_rank, lag, lead, cumulative_sum, moving_average

# Setup sample data: Employee sales table
# dept, emp, sales
s: Schema = Schema([
    ColumnDef("dept", TYPE_STR),
    ColumnDef("emp", TYPE_STR),
    ColumnDef("sales", TYPE_INT)
])

# Engineering: Alice: 100, Bob: 200, Charlie: 200, Dave: 300
# Sales: Eve: 150, Frank: 150, Grace: 250
r1: list[Cell] = [cell_str("Eng"), cell_str("Alice"), cell_int(100)]
r2: list[Cell] = [cell_str("Eng"), cell_str("Bob"), cell_int(200)]
r3: list[Cell] = [cell_str("Eng"), cell_str("Charlie"), cell_int(200)]
r4: list[Cell] = [cell_str("Eng"), cell_str("Dave"), cell_int(300)]
r5: list[Cell] = [cell_str("Sales"), cell_str("Eve"), cell_int(150)]
r6: list[Cell] = [cell_str("Sales"), cell_str("Frank"), cell_int(150)]
r7: list[Cell] = [cell_str("Sales"), cell_str("Grace"), cell_int(250)]

t: Table = Table(s, [r1, r2, r3, r4, r5, r6, r7])

# 1. Test row_number global (no partition)
t_rn_global: Table = row_number(t, "rn", [], ["sales"], True)
nox.test.assert_eq_int(t_rn_global.row_count(), 7, "row count preserved")
# Lowest sales is Alice (100) -> rn=1
# Highest is Dave (300) -> rn=7
nox.test.assert_eq_int(t_rn_global.rows[0][3].as_int(), 1, "Alice rn is 1")
nox.test.assert_eq_int(t_rn_global.rows[3][3].as_int(), 7, "Dave rn is 7")

# 2. Test row_number with partition_by=["dept"]
t_rn_part: Table = row_number(t, "dept_rn", ["dept"], ["sales"], True)
# For Eng: Alice (100) -> 1, Bob (200) -> 2, Charlie (200) -> 3, Dave (300) -> 4
# For Sales: Eve (150) -> 1, Frank (150) -> 2, Grace (250) -> 3
nox.test.assert_eq_int(t_rn_part.rows[0][3].as_int(), 1, "Alice dept_rn is 1")
nox.test.assert_eq_int(t_rn_part.rows[3][3].as_int(), 4, "Dave dept_rn is 4")
nox.test.assert_eq_int(t_rn_part.rows[4][3].as_int(), 1, "Eve dept_rn is 1")
nox.test.assert_eq_int(t_rn_part.rows[6][3].as_int(), 3, "Grace dept_rn is 3")

# 3. Test rank & dense_rank with ties
# In Eng, Bob and Charlie both have 200 sales
t_rank: Table = rank(t, "sales", "sales_rank", ["dept"], True)
# Alice(100) -> 1, Bob(200) -> 2, Charlie(200) -> 2, Dave(300) -> 4
nox.test.assert_eq_int(t_rank.rows[0][3].as_int(), 1, "Alice rank 1")
nox.test.assert_eq_int(t_rank.rows[1][3].as_int(), 2, "Bob rank 2")
nox.test.assert_eq_int(t_rank.rows[2][3].as_int(), 2, "Charlie rank 2")
nox.test.assert_eq_int(t_rank.rows[3][3].as_int(), 4, "Dave rank 4 (skipped 3)")

t_drank: Table = dense_rank(t, "sales", "sales_drank", ["dept"], True)
# Alice(100) -> 1, Bob(200) -> 2, Charlie(200) -> 2, Dave(300) -> 3
nox.test.assert_eq_int(t_drank.rows[0][3].as_int(), 1, "Alice dense rank 1")
nox.test.assert_eq_int(t_drank.rows[1][3].as_int(), 2, "Bob dense rank 2")
nox.test.assert_eq_int(t_drank.rows[2][3].as_int(), 2, "Charlie dense rank 2")
nox.test.assert_eq_int(t_drank.rows[3][3].as_int(), 3, "Dave dense rank 3 (no skip)")

# 4. Test lag & lead
t_lag: Table = lag(t, "sales", "prev_sales", 1, ["dept"], ["sales"], True, cell_int(-1))
# Alice has no prev in Eng -> -1
nox.test.assert_eq_int(t_lag.rows[0][3].as_int(), -1, "Alice lag is default -1")
# Bob's prev is Alice (100)
nox.test.assert_eq_int(t_lag.rows[1][3].as_int(), 100, "Bob lag is 100")

t_lead: Table = lead(t, "sales", "next_sales", 1, ["dept"], ["sales"], True, cell_int(-1))
# Dave is last in Eng -> -1
nox.test.assert_eq_int(t_lead.rows[3][3].as_int(), -1, "Dave lead is default -1")
# Alice's next is Bob (200)
nox.test.assert_eq_int(t_lead.rows[0][3].as_int(), 200, "Alice lead is 200")

# 5. Test cumulative_sum
t_cumsum: Table = cumulative_sum(t, "sales", "cum_sales", ["dept"], ["sales"], True)
# Eng: Alice: 100 -> 100, Bob: 200 -> 300, Charlie: 200 -> 500, Dave: 300 -> 800
nox.test.assert_eq_int(t_cumsum.rows[0][3].as_int(), 100, "cumsum Alice 100")
nox.test.assert_eq_int(t_cumsum.rows[1][3].as_int(), 300, "cumsum Bob 300")
nox.test.assert_eq_int(t_cumsum.rows[2][3].as_int(), 500, "cumsum Charlie 500")
nox.test.assert_eq_int(t_cumsum.rows[3][3].as_int(), 800, "cumsum Dave 800")

# Sales: Eve: 150 -> 150, Frank: 150 -> 300, Grace: 250 -> 550
nox.test.assert_eq_int(t_cumsum.rows[4][3].as_int(), 150, "cumsum Eve 150")
nox.test.assert_eq_int(t_cumsum.rows[5][3].as_int(), 300, "cumsum Frank 300")
nox.test.assert_eq_int(t_cumsum.rows[6][3].as_int(), 550, "cumsum Grace 550")

# 6. Test moving_average (window_size=2)
t_mavg: Table = moving_average(t, "sales", 2, "mavg_sales", ["dept"], ["sales"], True, 1)
# Eng:
# Alice: win=[100] -> 100.0
# Bob: win=[100, 200] -> 150.0
# Charlie: win=[200, 200] -> 200.0
# Dave: win=[200, 300] -> 250.0
nox.test.assert_true(t_mavg.rows[0][3].as_float() == 100.0, "Alice mavg is 100.0")
nox.test.assert_true(t_mavg.rows[1][3].as_float() == 150.0, "Bob mavg is 150.0")
nox.test.assert_true(t_mavg.rows[2][3].as_float() == 200.0, "Charlie mavg is 200.0")
nox.test.assert_true(t_mavg.rows[3][3].as_float() == 250.0, "Dave mavg is 250.0")

print("window_test passed")
