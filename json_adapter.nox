# json_adapter.nox — JSON array-of-objects import, export, and CSV <-> JSON conversion for Atlas.
# Uses Nox 2.2+ zero-allocation position-based tape navigation (nox.json.pos_*) for high-speed JSON parsing.

__all__: list[str] = ["table_from_json", "table_to_json", "csv_to_json", "json_to_csv", "table_to_json_rows", "table_from_json_rows"]

import nox.json
from nox.json import JsonWriter, JsonError, pos_root, pos_kind, pos_len, pos_at, pos_key, pos_find, pos_bool, pos_number, pos_int, pos_str, pos_dump
import nox.strings
import errors
from errors import JsonImportError, ShapeError, TypeConversionError, MissingValueError
import values
from values import Cell, cell_null, cell_int, cell_float, cell_str, cell_bool, cell_decimal_str, cell_datetime_ms, cell_datetime_str, TYPE_NULL, TYPE_INT, TYPE_FLOAT, TYPE_STR, TYPE_BOOL, TYPE_DECIMAL, TYPE_DATETIME
import schema
from schema import Schema, ColumnDef
import table
from table import Table
import csv_adapter
from csv_adapter import read_csv, to_csv

def _is_float_number_text(num_txt: str) -> bool:
    return "." in num_txt or "e" in num_txt or "E" in num_txt

def _infer_schema_from_tape(root: JsonValue, root_pos: int, num_items: int) -> Schema:
    discovered_keys: list[str] = []
    discovered_types: list[int] = []
    seen_key_idx: dict[str, int] = {}

    item_idx: int = 0
    while item_idx < num_items:
        elem_p: int = pos_at(root, root_pos, item_idx)
        if pos_kind(root, elem_p) != 5:
            raise JsonImportError("array element at index " + str(item_idx) + " is not a JSON object")
        num_keys: int = pos_len(root, elem_p)
        k_idx: int = 0
        while k_idx < num_keys:
            k_name: str = pos_key(root, elem_p, k_idx)
            val_p: int = pos_at(root, elem_p, k_idx)
            vk: int = pos_kind(root, val_p)

            val_type: int = TYPE_STR
            if vk == 0:
                val_type = TYPE_NULL
            elif vk == 1:
                val_type = TYPE_BOOL
            elif vk == 2:
                num_txt: str = pos_dump(root, val_p)
                if _is_float_number_text(num_txt):
                    val_type = TYPE_FLOAT
                else:
                    try:
                        _chk_int: int = pos_int(root, val_p)
                        val_type = TYPE_INT
                    except JsonError as je:
                        raise JsonImportError("JSON integer out of 64-bit signed range for key '" + k_name + "' at row " + str(item_idx) + ": " + str(je)) from je
            elif vk == 3:
                val_type = TYPE_STR
            else:
                raise JsonImportError("nested structures (arrays/objects) are not supported in 2D tabular cell")

            if k_name not in seen_key_idx:
                seen_key_idx[k_name] = len(discovered_keys)
                discovered_keys.append(k_name)
                discovered_types.append(val_type)
            else:
                existing_idx: int = seen_key_idx[k_name]
                curr_type: int = discovered_types[existing_idx]
                if curr_type == TYPE_NULL and val_type != TYPE_NULL:
                    discovered_types[existing_idx] = val_type
                elif (curr_type == TYPE_INT and val_type == TYPE_FLOAT) or (curr_type == TYPE_FLOAT and val_type == TYPE_INT):
                    discovered_types[existing_idx] = TYPE_FLOAT
                elif curr_type != val_type and val_type != TYPE_NULL:
                    discovered_types[existing_idx] = TYPE_STR
            k_idx = k_idx + 1
        item_idx = item_idx + 1

    cols: list[ColumnDef] = []
    c_i: int = 0
    while c_i < len(discovered_keys):
        t: int = discovered_types[c_i]
        if t == TYPE_NULL:
            t = TYPE_STR
        cols.append(ColumnDef(discovered_keys[c_i], t, True))
        c_i = c_i + 1
    return Schema(cols)

def table_from_json(json_text: str, explicit_schema: Schema | None = None) -> Table:
    root: JsonValue = nox.json.parse("null")
    try:
        root = nox.json.parse(json_text)
    except JsonError as je:
        raise JsonImportError("invalid JSON input: " + str(je)) from je

    root_pos: int = pos_root(root)
    if pos_kind(root, root_pos) != 4:
        raise JsonImportError("root JSON value must be an array of objects")

    num_items: int = pos_len(root, root_pos)
    if num_items == 0:
        if explicit_schema != None:
            empty_rows: list[list[Cell]] = []
            return Table(explicit_schema, empty_rows)
        empty_cols: list[ColumnDef] = []
        empty_schema: Schema = Schema(empty_cols)
        empty_table_rows: list[list[Cell]] = []
        return Table(empty_schema, empty_table_rows)

    s: Schema = Schema([])
    if explicit_schema != None:
        s = explicit_schema
    else:
        s = _infer_schema_from_tape(root, root_pos, num_items)

    expected_cols: int = s.column_count()
    rows: list[list[Cell]] = []
    r_i: int = 0

    while r_i < num_items:
        elem_p: int = pos_at(root, root_pos, r_i)
        if pos_kind(root, elem_p) != 5:
            raise JsonImportError("array element at index " + str(r_i) + " is not a JSON object")

        row: list[Cell] = []
        c_i: int = 0
        while c_i < expected_cols:
            col_def: ColumnDef = s.columns[c_i]
            val_p: int = pos_find(root, elem_p, col_def.name)
            cell: Cell = cell_null()
            if val_p >= 0:
                vk: int = pos_kind(root, val_p)
                if vk == 0:
                    cell = cell_null()
                elif col_def.data_type == TYPE_DECIMAL:
                    if vk == 2:
                        cell = cell_decimal_str(pos_dump(root, val_p))
                    elif vk == 3:
                        cell = cell_decimal_str(pos_str(root, val_p))
                    else:
                        raise JsonImportError("invalid Decimal value for column '" + col_def.name + "' at row " + str(r_i))
                elif col_def.data_type == TYPE_DATETIME:
                    if vk == 3:
                        cell = cell_datetime_str(pos_str(root, val_p))
                    elif vk == 2:
                        try:
                            cell = cell_datetime_ms(pos_int(root, val_p))
                        except JsonError as je:
                            raise JsonImportError("invalid DateTime epoch_ms for column '" + col_def.name + "' at row " + str(r_i) + ": " + str(je)) from je
                    else:
                        raise JsonImportError("invalid DateTime value for column '" + col_def.name + "' at row " + str(r_i))
                elif vk == 1:
                    cell = cell_bool(pos_bool(root, val_p))
                elif vk == 2:
                    if col_def.data_type == TYPE_INT:
                        try:
                            cell = cell_int(pos_int(root, val_p))
                        except JsonError as je:
                            raise JsonImportError("invalid integer value for column '" + col_def.name + "' at row " + str(r_i) + ": " + str(je)) from je
                    elif col_def.data_type == TYPE_FLOAT:
                        cell = cell_float(pos_number(root, val_p))
                    else:
                        raw_num_txt: str = pos_dump(root, val_p)
                        if _is_float_number_text(raw_num_txt):
                            cell = cell_float(pos_number(root, val_p))
                        else:
                            try:
                                cell = cell_int(pos_int(root, val_p))
                            except JsonError as je:
                                raise JsonImportError("invalid integer value for column '" + col_def.name + "' at row " + str(r_i) + ": " + str(je)) from je
                elif vk == 3:
                    cell = cell_str(pos_str(root, val_p))
                else:
                    raise JsonImportError("nested structures (arrays/objects) are not supported in 2D tabular cell")

            if not col_def.nullable and cell.is_missing():
                raise MissingValueError("column '" + col_def.name + "' is not nullable, but missing value found at row " + str(r_i))

            row.append(cell)
            c_i = c_i + 1

        rows.append(row)
        r_i = r_i + 1

    return Table(s, rows)

def table_to_json(t: Table) -> str:
    w: JsonWriter = JsonWriter()
    w.begin_array()

    r_idx: int = 0
    num_rows: int = t.row_count()
    num_cols: int = t.column_count()

    while r_idx < num_rows:
        row: list[Cell] = t.rows[r_idx]
        w.begin_object()
        c_idx: int = 0
        while c_idx < num_cols:
            col: ColumnDef = t.schema.columns[c_idx]
            w.write_key(col.name)
            c: Cell = row[c_idx]
            if c.is_missing():
                w.write_null()
            elif c.kind == TYPE_INT:
                w.write_int(c.i)
            elif c.kind == TYPE_FLOAT:
                w.write_float(c.f)
            elif c.kind == TYPE_BOOL:
                w.write_bool(c.b)
            elif c.kind == TYPE_STR:
                w.write_string(c.s)
            elif c.kind == TYPE_DECIMAL or c.kind == TYPE_DATETIME:
                w.write_string(c.to_string())
            else:
                w.write_string(c.to_string())
            c_idx = c_idx + 1
        w.end_object()
        r_idx = r_idx + 1

    w.end_array()
    return w.build()

def csv_to_json(csv_text: str, has_header: bool = True) -> str:
    t: Table = read_csv(csv_text, has_header)
    return table_to_json(t)

def json_to_csv(json_text: str, include_header: bool = True, safe_spreadsheet: bool = False) -> str:
    t: Table = table_from_json(json_text)
    return to_csv(t, include_header, safe_spreadsheet)

# ---------------------------------------------------------------------------
# @dataclass / @derive("json", "order", "copy") row-level JSON interop
# ---------------------------------------------------------------------------

def table_to_json_rows(t: Table) -> list[str]:
    out: list[str] = []
    r_idx: int = 0
    num_rows: int = t.row_count()
    num_cols: int = t.column_count()
    while r_idx < num_rows:
        row: list[Cell] = t.rows[r_idx]
        w: JsonWriter = JsonWriter()
        w.begin_object()
        c_idx: int = 0
        while c_idx < num_cols:
            col: ColumnDef = t.schema.columns[c_idx]
            w.write_key(col.name)
            c: Cell = row[c_idx]
            if c.is_missing():
                w.write_null()
            elif c.kind == TYPE_INT:
                w.write_int(c.i)
            elif c.kind == TYPE_FLOAT:
                w.write_float(c.f)
            elif c.kind == TYPE_BOOL:
                w.write_bool(c.b)
            elif c.kind == TYPE_STR:
                w.write_string(c.s)
            else:
                w.write_string(c.to_string())
            c_idx = c_idx + 1
        w.end_object()
        out.append(w.build())
        r_idx = r_idx + 1
    return out

def table_from_json_rows(json_objects: list[str], explicit_schema: Schema | None = None) -> Table:
    if len(json_objects) == 0:
        return table_from_json("[]", explicit_schema)
    arr_text: str = "[" + nox.strings.join(json_objects, ",") + "]"
    return table_from_json(arr_text, explicit_schema)
