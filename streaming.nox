# streaming.nox — Low-memory Streaming CSV reader and chunk-based processing for Atlas.

import nox.fs
import nox.mathx
import nox.strings
import errors
from errors import AtlasError, CsvImportError, ShapeError, MissingValueError, ColumnNotFoundError, AggregationError
import values
from values import Cell, cell_null, parse_cell, TYPE_INT, TYPE_FLOAT, TYPE_STR, TYPE_BOOL
import schema
from schema import Schema, ColumnDef
import table
from table import Table
import stats
from stats import stat_sum, stat_count_non_missing
import delimited
from delimited import CsvOptions, csv_options, parse_delimited
import csv_adapter
from csv_adapter import infer_schema

class StreamingCsvReader:
    path: str
    reader: nox.fs.FileReader
    options: CsvOptions
    chunk_rows: int
    chunk_bytes: int
    schema: Schema
    headers: list[str]
    eof: bool
    closed: bool
    has_more: bool

    # Persistent state machine across chunks
    unconsumed_buffer: str
    pending_rows: list[list[str]]
    cur_row: list[str]
    cur_field: str
    in_quotes: bool
    after_quote: bool
    field_start: bool
    pending_cr: bool
    pending_quote: bool
    cur_record_bytes: int

    def __init__(self: StreamingCsvReader, path: str, options: CsvOptions | None = None, explicit_schema: Schema | None = None, chunk_rows: int = 1000, chunk_bytes: int = 65536) -> None:
        if chunk_rows <= 0 or chunk_bytes <= 0:
            raise AtlasError("chunk_rows and chunk_bytes must be positive integers")

        self.path = path
        if options != None:
            self.options = options
        else:
            self.options = csv_options()

        if self.options.max_record_bytes <= 0:
            raise AtlasError("max_record_bytes must be a positive integer")

        self.chunk_rows = chunk_rows
        self.chunk_bytes = chunk_bytes
        if explicit_schema != None:
            self.schema = explicit_schema
        else:
            empty_cols: list[ColumnDef] = []
            self.schema = Schema(empty_cols)
        self.headers = []
        self.eof = False
        self.closed = False
        self.has_more = True

        # Initialize persistent parser state
        self.unconsumed_buffer = ""
        self.pending_rows = []
        self.cur_row = []
        self.cur_field = ""
        self.in_quotes = False
        self.after_quote = False
        self.field_start = True
        self.pending_cr = False
        self.pending_quote = False
        self.cur_record_bytes = 0

        if not nox.fs.exists(path):
            raise AtlasError("file not found: '" + path + "'")
        self.reader = nox.fs.open_read(path)

    def close(self: StreamingCsvReader) -> None:
        if not self.closed:
            self.closed = True
            self.reader.close()
            self.has_more = False

    def has_next(self: StreamingCsvReader) -> bool:
        if self.closed:
            return False
        if len(self.pending_rows) > 0 or len(self.unconsumed_buffer) > 0:
            return True
        if self.eof:
            return False
        return self.has_more

    def feed_chunk(self: StreamingCsvReader, text: str, target_rows: int) -> None:
        i: int = 0
        n: int = len(text)
        delim: str = self.options.delimiter
        delim_len: int = len(delim)
        strict: bool = self.options.strict
        max_rec: int = self.options.max_record_bytes

        while i < n:
            ch: str = text[i]

            # 1. Resolve pending_cr from end of previous chunk
            if self.pending_cr:
                self.pending_cr = False
                if ch == "\n":
                    i = i + 1
                    continue

            # 2. Resolve pending_quote from end of previous chunk
            if self.pending_quote:
                self.pending_quote = False
                if ch == "\"":
                    # Escaped quote "" split across chunk boundary
                    self.cur_field = self.cur_field + "\""
                    self.cur_record_bytes = self.cur_record_bytes + 1
                    i = i + 1
                    continue
                else:
                    # Closing quote confirmed!
                    self.in_quotes = False
                    self.after_quote = True
                    # fall through to process ch in after_quote state

            ch_bytes: int = nox.strings.byte_len(ch)
            self.cur_record_bytes = self.cur_record_bytes + ch_bytes
            if self.cur_record_bytes > max_rec:
                raise CsvImportError("CSV record exceeds max_record_bytes limit (" + str(max_rec) + " bytes)")

            if self.in_quotes:
                if ch == "\"":
                    if i + 1 < n:
                        if text[i + 1] == "\"":
                            self.cur_field = self.cur_field + "\""
                            self.cur_record_bytes = self.cur_record_bytes + 1
                            i = i + 2
                        else:
                            self.in_quotes = False
                            self.after_quote = True
                            i = i + 1
                    else:
                        # Quote is at very end of chunk! Wait for next chunk
                        self.pending_quote = True
                        i = i + 1
                else:
                    self.cur_field = self.cur_field + ch
                    i = i + 1
            elif self.after_quote:
                # If near end of chunk and remaining matches prefix of multi-char delimiter:
                rem_len: int = n - i
                if delim_len > 1 and rem_len < delim_len and delim[0:rem_len] == text[i:]:
                    self.unconsumed_buffer = text[i:]
                    return

                if delim_len == 1 and ch == delim:
                    self.cur_row.append(self.cur_field)
                    self.cur_field = ""
                    self.after_quote = False
                    self.field_start = True
                    i = i + 1
                elif delim_len > 1 and i + delim_len <= n and text[i:i + delim_len] == delim:
                    self.cur_row.append(self.cur_field)
                    self.cur_field = ""
                    self.after_quote = False
                    self.field_start = True
                    i = i + delim_len
                elif ch == "\r":
                    if i + 1 < n:
                        if text[i + 1] == "\n":
                            i = i + 1
                    else:
                        self.pending_cr = True
                    self.cur_row.append(self.cur_field)
                    self.cur_field = ""
                    self.pending_rows.append(self.cur_row)
                    self.cur_row = []
                    self.after_quote = False
                    self.field_start = True
                    self.cur_record_bytes = 0
                    i = i + 1
                    if len(self.pending_rows) >= target_rows:
                        if i < n:
                            self.unconsumed_buffer = text[i:]
                        return
                elif ch == "\n":
                    self.cur_row.append(self.cur_field)
                    self.cur_field = ""
                    self.pending_rows.append(self.cur_row)
                    self.cur_row = []
                    self.after_quote = False
                    self.field_start = True
                    self.cur_record_bytes = 0
                    i = i + 1
                    if len(self.pending_rows) >= target_rows:
                        if i < n:
                            self.unconsumed_buffer = text[i:]
                        return
                else:
                    if strict:
                        raise CsvImportError("unexpected character after closing quote in strict mode: '" + ch + "'")
                    self.cur_field = self.cur_field + ch
                    self.after_quote = False
                    i = i + 1
            else:
                # Unquoted field
                # Check for prefix of multi-char delimiter at end of chunk:
                rem_len: int = n - i
                if delim_len > 1 and rem_len < delim_len and delim[0:rem_len] == text[i:]:
                    self.unconsumed_buffer = text[i:]
                    return

                if self.field_start and ch == "\"":
                    self.in_quotes = True
                    self.field_start = False
                    i = i + 1
                elif ch == "\"":
                    if strict:
                        raise CsvImportError("unescaped quote in unquoted field in strict mode")
                    self.cur_field = self.cur_field + "\""
                    i = i + 1
                elif delim_len == 1 and ch == delim:
                    self.cur_row.append(self.cur_field)
                    self.cur_field = ""
                    self.field_start = True
                    i = i + 1
                elif delim_len > 1 and i + delim_len <= n and text[i:i + delim_len] == delim:
                    self.cur_row.append(self.cur_field)
                    self.cur_field = ""
                    self.field_start = True
                    i = i + delim_len
                elif ch == "\r":
                    if i + 1 < n:
                        if text[i + 1] == "\n":
                            i = i + 1
                    else:
                        self.pending_cr = True
                    self.cur_row.append(self.cur_field)
                    self.cur_field = ""
                    self.pending_rows.append(self.cur_row)
                    self.cur_row = []
                    self.field_start = True
                    self.cur_record_bytes = 0
                    i = i + 1
                    if len(self.pending_rows) >= target_rows:
                        if i < n:
                            self.unconsumed_buffer = text[i:]
                        return
                elif ch == "\n":
                    self.cur_row.append(self.cur_field)
                    self.cur_field = ""
                    self.pending_rows.append(self.cur_row)
                    self.cur_row = []
                    self.field_start = True
                    self.cur_record_bytes = 0
                    i = i + 1
                    if len(self.pending_rows) >= target_rows:
                        if i < n:
                            self.unconsumed_buffer = text[i:]
                        return
                else:
                    self.cur_field = self.cur_field + ch
                    self.field_start = False
                    i = i + 1

    def finish_parser(self: StreamingCsvReader) -> None:
        if len(self.unconsumed_buffer) > 0:
            self.cur_field = self.cur_field + self.unconsumed_buffer
            self.unconsumed_buffer = ""
        if self.pending_quote:
            self.in_quotes = False
            self.after_quote = True
            self.pending_quote = False
        if self.pending_cr:
            self.pending_cr = False
        if self.in_quotes:
            raise CsvImportError("unclosed quoted field in stream at EOF")
        if len(self.cur_field) > 0 or len(self.cur_row) > 0 or self.after_quote:
            self.cur_row.append(self.cur_field)
            self.pending_rows.append(self.cur_row)
            self.cur_row = []
            self.cur_field = ""
            self.after_quote = False
            self.cur_record_bytes = 0

    def next_chunk(self: StreamingCsvReader) -> Table:
        if self.closed or (not self.has_more and len(self.pending_rows) == 0):
            raise AtlasError("no more chunks in stream: '" + self.path + "'")

        target_rows: int = self.chunk_rows
        fetch_target: int = target_rows
        if len(self.headers) == 0 and self.options.has_header:
            fetch_target = target_rows + 1

        dlen: int = len(self.options.delimiter)

        while len(self.pending_rows) < fetch_target:
            if len(self.unconsumed_buffer) >= dlen:
                buf: str = self.unconsumed_buffer
                self.unconsumed_buffer = ""
                self.feed_chunk(buf, fetch_target)
                if len(self.pending_rows) >= fetch_target:
                    break

            if not self.eof:
                chunk_str: str = self.reader.read_chunk(self.chunk_bytes)
                if len(chunk_str) == 0:
                    self.eof = True
                    self.finish_parser()
                else:
                    to_feed: str = self.unconsumed_buffer + chunk_str
                    self.unconsumed_buffer = ""
                    self.feed_chunk(to_feed, fetch_target)
            else:
                if len(self.unconsumed_buffer) > 0:
                    self.finish_parser()
                break

        if len(self.pending_rows) == 0:
            self.close()
            empty_cols: list[ColumnDef] = []
            return Table(Schema(empty_cols), [])

        # Process headers on first chunk
        if len(self.headers) == 0:
            if self.options.has_header:
                self.headers = self.pending_rows[0]
                self.pending_rows = self.pending_rows[1:]
            else:
                num_c: int = len(self.pending_rows[0])
                ci: int = 0
                while ci < num_c:
                    self.headers.append("col_" + str(ci))
                    ci = ci + 1

        data_rows: list[list[str]] = []
        take_count: int = target_rows
        if len(self.pending_rows) < take_count:
            take_count = len(self.pending_rows)

        ti: int = 0
        while ti < take_count:
            data_rows.append(self.pending_rows[ti])
            ti = ti + 1

        self.pending_rows = self.pending_rows[take_count:]

        # Probe next bytes to detect EOF immediately if pending_rows and unconsumed_buffer are empty
        if not self.eof and len(self.pending_rows) == 0 and len(self.unconsumed_buffer) == 0:
            probe_chunk: str = self.reader.read_chunk(self.chunk_bytes)
            if len(probe_chunk) == 0:
                self.eof = True
                self.finish_parser()
            else:
                self.feed_chunk(probe_chunk, fetch_target)

        if self.eof and len(self.pending_rows) == 0 and len(self.unconsumed_buffer) == 0:
            self.has_more = False
            self.close()

        # Infer schema on first data rows if not already defined
        if self.schema.column_count() == 0:
            if len(data_rows) > 0:
                self.schema = infer_schema(self.headers, data_rows, self.options.blank_is_missing)
            else:
                col_defs: list[ColumnDef] = []
                hi: int = 0
                while hi < len(self.headers):
                    col_defs.append(ColumnDef(self.headers[hi], TYPE_STR, True))
                    hi = hi + 1
                self.schema = Schema(col_defs)

        sch: Schema = self.schema
        num_cols: int = sch.column_count()
        typed_rows: list[list[Cell]] = []

        r_idx: int = 0
        num_data: int = len(data_rows)
        while r_idx < num_data:
            raw_r: list[str] = data_rows[r_idx]
            if len(raw_r) != num_cols:
                raise ShapeError("streaming row length mismatch: expected " + str(num_cols) + ", got " + str(len(raw_r)))
            
            typed_r: list[Cell] = []
            c_idx: int = 0
            while c_idx < num_cols:
                col_def: ColumnDef = sch.columns[c_idx]
                raw_cell: str = raw_r[c_idx]
                c: Cell = parse_cell(raw_cell, col_def.data_type, self.options.blank_is_missing)
                if not col_def.nullable and c.is_missing():
                    raise MissingValueError("column '" + col_def.name + "' is not nullable, but missing value found in stream")
                typed_r.append(c)
                c_idx = c_idx + 1

            typed_rows.append(typed_r)
            r_idx = r_idx + 1

        return Table(sch, typed_rows)

def open_csv_stream(path: str, chunk_rows: int = 1000, options: CsvOptions | None = None, explicit_schema: Schema | None = None) -> StreamingCsvReader:
    return StreamingCsvReader(path, options, explicit_schema, chunk_rows)

def stream_count(path: str, options: CsvOptions | None = None) -> int:
    reader: StreamingCsvReader = open_csv_stream(path, 2000, options)
    total: int = 0
    try:
        while reader.has_next():
            chunk_tbl: Table = reader.next_chunk()
            total = total + chunk_tbl.row_count()
    finally:
        reader.close()
    return total

def stream_sum(path: str, col_name: str, options: CsvOptions | None = None) -> float:
    reader: StreamingCsvReader = open_csv_stream(path, 2000, options)
    running_sum: float = 0.0
    try:
        while reader.has_next():
            chunk_tbl: Table = reader.next_chunk()
            if chunk_tbl.row_count() > 0:
                running_sum = running_sum + chunk_tbl.sum_val(col_name)
    finally:
        reader.close()
    return running_sum

def stream_mean(path: str, col_name: str, options: CsvOptions | None = None) -> float:
    reader: StreamingCsvReader = open_csv_stream(path, 2000, options)
    running_n: int = 0
    running_mean: float = 0.0
    try:
        while reader.has_next():
            chunk_tbl: Table = reader.next_chunk()
            if chunk_tbl.row_count() == 0:
                continue
            cells: list[Cell] = chunk_tbl.column_cells(col_name)
            c_idx: int = 0
            n_cells: int = len(cells)
            nc: int = 0
            mc: float = 0.0
            while c_idx < n_cells:
                c: Cell = cells[c_idx]
                if not c.is_missing():
                    nc = nc + 1
                    x: float = c.as_float()
                    mc = mc + (x - mc) / float(nc)
                c_idx = c_idx + 1

            if nc > 0:
                if running_n == 0:
                    running_n = nc
                    running_mean = mc
                else:
                    new_n: int = running_n + nc
                    delta: float = mc - running_mean
                    running_mean = running_mean + delta * (float(nc) / float(new_n))
                    running_n = new_n
    finally:
        reader.close()

    if running_n == 0:
        raise AggregationError("cannot compute mean: no non-missing numeric observations")

    return running_mean

def stream_variance(path: str, col_name: str, options: CsvOptions | None = None, is_sample: bool = True) -> float:
    reader: StreamingCsvReader = open_csv_stream(path, 2000, options)
    running_n: int = 0
    running_mean: float = 0.0
    running_m2: float = 0.0
    try:
        while reader.has_next():
            chunk_tbl: Table = reader.next_chunk()
            if chunk_tbl.row_count() == 0:
                continue
            cells: list[Cell] = chunk_tbl.column_cells(col_name)
            c_idx: int = 0
            n_cells: int = len(cells)
            nc: int = 0
            mc: float = 0.0
            m2c: float = 0.0
            while c_idx < n_cells:
                c: Cell = cells[c_idx]
                if not c.is_missing():
                    nc = nc + 1
                    x: float = c.as_float()
                    delta: float = x - mc
                    mc = mc + delta / float(nc)
                    delta2: float = x - mc
                    m2c = m2c + delta * delta2
                c_idx = c_idx + 1

            if nc > 0:
                if running_n == 0:
                    running_n = nc
                    running_mean = mc
                    running_m2 = m2c
                else:
                    new_n: int = running_n + nc
                    d: float = mc - running_mean
                    running_mean = running_mean + d * (float(nc) / float(new_n))
                    running_m2 = running_m2 + m2c + (d * d) * (float(running_n) * float(nc) / float(new_n))
                    running_n = new_n
    finally:
        reader.close()

    if running_n == 0:
        raise AggregationError("cannot compute variance: no non-missing numeric observations")
    if is_sample:
        if running_n < 2:
            raise AggregationError("sample variance requires at least 2 non-missing numeric observations")
        return running_m2 / float(running_n - 1)
    return running_m2 / float(running_n)

def stream_std(path: str, col_name: str, options: CsvOptions | None = None, is_sample: bool = True) -> float:
    v: float = stream_variance(path, col_name, options, is_sample)
    if v < 0.0:
        return 0.0
    return nox.mathx.sqrt(v)
